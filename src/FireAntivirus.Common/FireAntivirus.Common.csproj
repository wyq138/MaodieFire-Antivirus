<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <RootNamespace>FireAntivirus.Common</RootNamespace>
    <AssemblyName>FireAntivirus.Common</AssemblyName>
    <Deterministic>true</Deterministic>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateReferenceAssembly>true</GenerateReferenceAssembly>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <!-- WinForms/WPF 引用由下方 UseWindowsForms/UseWPF 框架特性提供，勿再引用 nuget 旧包（NU1701/漏洞传递源） -->
    <PackageReference Include="System.Management" Version="7.0.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.0" />
    <PackageReference Include="System.Data.SQLite" Version="1.0.118" />
    <!-- 显式升级传递依赖 System.Data.SqlClient 4.8.1 -> 4.8.6（修复已知漏洞 NU1902） -->
    <PackageReference Include="System.Data.SqlClient" Version="4.8.6" />
  </ItemGroup>




  <ItemGroup>
    <EmbeddedResource Include="KnowledgeBase\*.json" />
  </ItemGroup>
</Project>









