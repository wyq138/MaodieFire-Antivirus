<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>false</UseWindowsForms>
    <RootNamespace>FireAntivirus.Engine</RootNamespace>
    <AssemblyName>FireAntivirus.Engine</AssemblyName>
    <Deterministic>true</Deterministic>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateReferenceAssembly>true</GenerateReferenceAssembly>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Management" Version="7.0.0" />
    <PackageReference Include="System.Drawing.Common" Version="6.0.0" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="6.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <!-- ETW-TI 内核行为遥测（Process/FileIO/NetworkTCPIP/Registry，需管理员） -->
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.1.20" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FireAntivirus.Common\FireAntivirus.Common.csproj" />
    <ProjectReference Include="..\FireAntivirus.Data\FireAntivirus.Data.csproj" />

  </ItemGroup>

  <ItemGroup>
    <None Update="ThreatData\**\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="KnowledgeBase\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Strings\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
