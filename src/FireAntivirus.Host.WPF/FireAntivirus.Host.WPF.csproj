<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>FireAntivirus.Host</RootNamespace>
    <AssemblyName>FireAntivirus</AssemblyName>
    <SelfContained>false</SelfContained>
    <Version>1.0.0</Version>
    <Company>耄耋安全软件</Company>
    <ApplicationIcon>Resources\cat_icon.ico</ApplicationIcon>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="System.Management" Version="7.0.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\FireAntivirus.Engine\FireAntivirus.Engine.csproj" />
    <ProjectReference Include="..\FireAntivirus.Data\FireAntivirus.Data.csproj" />
    <ProjectReference Include="..\FireAntivirus.Services\FireAntivirus.Services.csproj" />
    <ProjectReference Include="..\FireAntivirus.Common\FireAntivirus.Common.csproj" />
    <ProjectReference Include="..\FireAntivirus.ClamAV\FireAntivirus.ClamAV.csproj" />
    <!-- 引用后台防护项目，使其exe在构建后自动复制到主程序输出目录 -->
    <ProjectReference Include="..\FireAntivirus.ServiceHost\FireAntivirus.ServiceHost.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <OutputItemType>Content</OutputItemType>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Resources\**\*" />
  </ItemGroup>
  <!-- 确保后台防护的exe和运行配置文件复制到主程序输出目录 -->
  <Target Name="CopyServiceHostOutputs" AfterTargets="Build">
    <PropertyGroup>
      <ServiceHostOutputPath>$(MSBuildProjectDirectory)\..\FireAntivirus.ServiceHost\bin\$(Configuration)\net10.0-windows\</ServiceHostOutputPath>
    </PropertyGroup>
    <Copy SourceFiles="$(ServiceHostOutputPath)FireAntivirus.ServiceHost.exe" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" Condition="Exists('$(ServiceHostOutputPath)FireAntivirus.ServiceHost.exe')" />
    <Copy SourceFiles="$(ServiceHostOutputPath)FireAntivirus.ServiceHost.runtimeconfig.json" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" Condition="Exists('$(ServiceHostOutputPath)FireAntivirus.ServiceHost.runtimeconfig.json')" />
  </Target>
</Project>
