<Page x:Class="FireAntivirus.Host.WPF.Pages.PasswordManagerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="密码管理">

    <Grid x:Name="MainGrid" Background="{DynamicResource BgPrimary}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- 标题区域 -->
        <Grid Grid.Row="0" Margin="20,15">
            <TextBlock x:Name="TitleText" 
                       Text="密码管理" 
                       FontSize="18" 
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimary}"/>
        </Grid>
        
        <!-- 内容区域 -->
        <ScrollViewer Grid.Row="1" Margin="20,0,20,20">
            <StackPanel>
                <!-- 密码列表卡片 -->
                <Border Background="{DynamicResource CardBg}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="0,0,0,15"
                        Padding="15">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="🔐 密码列表" 
                                       FontSize="14" 
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimary}"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"/>
                            
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="AddPasswordBtn" 
                                        Content="添加" 
                                        Width="70" 
                                        Height="28"
                                        Margin="0,0,5,0"
                                        Background="{DynamicResource BgTertiary}"
                                        Foreground="{DynamicResource TextPrimary}"
                                        BorderBrush="{DynamicResource BorderColor}"
                                        BorderThickness="1"
                                        Cursor="Hand"/>
                                <Button x:Name="EditPasswordBtn" 
                                        Content="编辑" 
                                        Width="70" 
                                        Height="28"
                                        Margin="0,0,5,0"
                                        Background="{DynamicResource BgTertiary}"
                                        Foreground="{DynamicResource TextPrimary}"
                                        BorderBrush="{DynamicResource BorderColor}"
                                        BorderThickness="1"
                                        Cursor="Hand"/>
                                <Button x:Name="DeletePasswordBtn" 
                                        Content="删除" 
                                        Width="70" 
                                        Height="28"
                                        Background="{DynamicResource BgTertiary}"
                                        Foreground="{DynamicResource TextPrimary}"
                                        BorderBrush="{DynamicResource BorderColor}"
                                        BorderThickness="1"
                                        Cursor="Hand"/>
                            </StackPanel>
                        </Grid>
                        
                        <DataGrid x:Name="PasswordDataGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  Height="200"
                                  Background="{DynamicResource BgTertiary}"
                                  Foreground="{DynamicResource TextPrimary}"
                                  BorderBrush="{DynamicResource BorderColor}"
                                  BorderThickness="1"
                                  GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="网站" Binding="{Binding Website}" Width="150"/>
                                <DataGridTextColumn Header="用户名" Binding="{Binding Username}" Width="120"/>
                                <DataGridTextColumn Header="密码" Binding="{Binding Password}" Width="120"/>
                                <DataGridTextColumn Header="最后修改" Binding="{Binding LastModified}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
                
                <!-- 密码生成器卡片 -->
                <Border Background="{DynamicResource CardBg}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="0,0,0,15"
                        Padding="15">
                    <StackPanel>
                        <TextBlock Text="🔑 密码生成器" 
                                   FontSize="14" 
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   Margin="0,0,0,10"/>
                        
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" 
                                       Text="密码长度：" 
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimary}"
                                       Margin="0,0,10,0"/>
                            <Slider x:Name="PasswordLengthSlider" 
                                    Grid.Column="1"
                                    Minimum="8" 
                                    Maximum="32" 
                                    Value="16"
                                    VerticalAlignment="Center"
                                    Margin="0,0,10,0"/>
                            <TextBlock x:Name="PasswordLengthText" 
                                       Grid.Column="2"
                                       Text="16" 
                                       VerticalAlignment="Center"
                                       Width="30"
                                       Foreground="{DynamicResource TextPrimary}"/>
                        </Grid>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <CheckBox x:Name="IncludeUppercase" 
                                      Content="大写字母" 
                                      IsChecked="True" 
                                      Margin="0,0,20,0"
                                      Foreground="{DynamicResource TextPrimary}"/>
                            <CheckBox x:Name="IncludeLowercase" 
                                      Content="小写字母" 
                                      IsChecked="True" 
                                      Margin="0,0,20,0"
                                      Foreground="{DynamicResource TextPrimary}"/>
                            <CheckBox x:Name="IncludeNumbers" 
                                      Content="数字" 
                                      IsChecked="True" 
                                      Margin="0,0,20,0"
                                      Foreground="{DynamicResource TextPrimary}"/>
                            <CheckBox x:Name="IncludeSymbols" 
                                      Content="特殊字符" 
                                      IsChecked="True"
                                      Foreground="{DynamicResource TextPrimary}"/>
                        </StackPanel>
                        
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBox x:Name="GeneratedPasswordTextBox" 
                                     Grid.Column="0"
                                     Height="32"
                                     Margin="0,0,10,0"
                                     VerticalContentAlignment="Center"
                                     IsReadOnly="True"
                                     Background="{DynamicResource BgTertiary}"
                                     Foreground="{DynamicResource TextPrimary}"
                                     BorderBrush="{DynamicResource BorderColor}"/>
                            <Button x:Name="GeneratePasswordBtn" 
                                    Grid.Column="1"
                                    Content="生成密码" 
                                    Width="100" 
                                    Height="32"
                                    Background="{DynamicResource PrimaryColor}"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Cursor="Hand"/>
                        </Grid>
                    </StackPanel>
                </Border>
                
                <!-- 安全检查卡片 -->
                <Border Background="{DynamicResource CardBg}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="0,0,0,15"
                        Padding="15">
                    <StackPanel>
                        <TextBlock Text="🛡️ 密码安全" 
                                   FontSize="14" 
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   Margin="0,0,0,10"/>
                        
                        <TextBlock Text="检查密码强度和安全性，识别弱密码和重复使用的密码" 
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Margin="0,0,0,10"/>
                        
                        <Button x:Name="SecurityCheckBtn" 
                                Content="开始安全检查" 
                                Width="120" 
                                Height="35"
                                Background="{DynamicResource PrimaryColor}"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand"
                                HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
