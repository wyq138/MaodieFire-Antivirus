<Page x:Class="FireAntivirus.Host.WPF.Pages.ScanPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="病毒扫描">
    
    <Grid x:Name="MainGrid" Background="{DynamicResource BgPrimary}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- 标题 -->
        <TextBlock x:Name="TitleText"
                   Grid.Row="0" 
                   Text="专业病毒扫描" 
                   FontSize="22" 
                   FontWeight="Bold"
                   Foreground="{DynamicResource TextPrimary}"
                   Margin="20,20,20,10"/>
        
        <!-- 扫描类型选择 -->
        <Grid x:Name="ScanTypePanel" Grid.Row="1" Margin="20,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <Button Grid.Column="0" 
                    Tag="Quick"
                    Background="{DynamicResource BgTertiary}"
                    Foreground="{DynamicResource TextPrimary}"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1"
                    Height="70"
                    Margin="0,0,10,0"
                    Click="ScanTypeButton_Click"
                    Cursor="Hand">
                <StackPanel>
                    <TextBlock Text="🔍" FontSize="24" HorizontalAlignment="Center"/>
                    <TextBlock Text="快速扫描" FontSize="12" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    <TextBlock Text="用户目录+启动项" FontSize="9" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>
            
            <Button Grid.Column="1" 
                    Tag="Full"
                    Background="{DynamicResource BgTertiary}"
                    Foreground="{DynamicResource TextPrimary}"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1"
                    Height="70"
                    Margin="10,0,10,0"
                    Click="ScanTypeButton_Click"
                    Cursor="Hand">
                <StackPanel>
                    <TextBlock Text="📁" FontSize="24" HorizontalAlignment="Center"/>
                    <TextBlock Text="全盘扫描" FontSize="12" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    <TextBlock Text="完整扫描+内存+注册表" FontSize="9" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>
            
            <Button Grid.Column="2" 
                    Tag="Deep"
                    Background="{DynamicResource BgTertiary}"
                    Foreground="{DynamicResource TextPrimary}"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1"
                    Height="70"
                    Margin="10,0,10,0"
                    Click="ScanTypeButton_Click"
                    Cursor="Hand">
                <StackPanel>
                    <TextBlock Text="🔬" FontSize="24" HorizontalAlignment="Center"/>
                    <TextBlock Text="深度扫描" FontSize="12" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    <TextBlock Text="启发式+行为分析" FontSize="9" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>
            
            <Button Grid.Column="3" 
                    Tag="Custom"
                    Background="{DynamicResource BgTertiary}"
                    Foreground="{DynamicResource TextPrimary}"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1"
                    Height="70"
                    Margin="10,0,0,0"
                    Click="ScanTypeButton_Click"
                    Cursor="Hand">
                <StackPanel>
                    <TextBlock Text="✏️" FontSize="24" HorizontalAlignment="Center"/>
                    <TextBlock Text="自定义扫描" FontSize="12" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    <TextBlock Text="选择指定目录" FontSize="9" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>
        
        <!-- 控制面板 -->
        <Grid Grid.Row="2" Margin="20,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- 按钮 -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <Button x:Name="StartScanBtn"
                        Grid.Column="0"
                        Content="开始扫描"
                        Background="{DynamicResource PrimaryColor}"
                        Foreground="White"
                        Height="40"
                        Margin="0,0,10,0"
                        Click="StartScan_Click"
                        Cursor="Hand"/>
                
                <Button x:Name="PauseScanBtn"
                        Grid.Column="1"
                        Content="暂停扫描"
                        Background="{DynamicResource BgTertiary}"
                        Foreground="{DynamicResource TextPrimary}"
                        Height="40"
                        Margin="10,0,10,0"
                        Click="PauseScan_Click"
                        Cursor="Hand"/>
                
                <Button x:Name="StopScanBtn"
                        Grid.Column="2"
                        Content="停止扫描"
                        Background="{DynamicResource BgTertiary}"
                        Foreground="{DynamicResource TextPrimary}"
                        Height="40"
                        Margin="10,0,0,0"
                        IsEnabled="False"
                        Click="StopScan_Click"
                        Cursor="Hand"/>
            </Grid>
            
            <!-- 进度条 -->
            <ProgressBar x:Name="ScanProgressBar"
                         Grid.Row="1"
                         Height="8"
                         Minimum="0"
                         Maximum="100"
                         Value="0"
                         Margin="0,0,0,10"
                         Foreground="{DynamicResource PrimaryColor}"/>
            
            <!-- 进度文本 -->
            <TextBlock x:Name="ProgressLabel"
                       Grid.Row="2"
                       Text="就绪 - 选择扫描类型开始扫描"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondary}"
                       Margin="0,0,0,5"/>
            
            <!-- 状态文本 -->
            <TextBlock x:Name="StatusLabel"
                       Grid.Row="3"
                       Text="专业杀毒引擎已加载"
                       FontSize="14"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimary}"/>
        </Grid>
        
        <!-- 结果列表 -->
        <Grid Grid.Row="3" Margin="20,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <TextBlock Text="扫描结果" 
                           FontSize="16" 
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimary}"
                           VerticalAlignment="Center"/>
                
                <!-- 威胁处理按钮 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="删除"
                            Width="60" Height="28"
                            Margin="5,0"
                            Background="#E74C3C"
                            Foreground="White"
                            Click="DeleteThreat_Click"
                            Cursor="Hand"/>
                    <Button Content="隔离"
                            Width="60" Height="28"
                            Margin="5,0"
                            Background="#F39C12"
                            Foreground="White"
                            Click="QuarantineThreat_Click"
                            Cursor="Hand"/>
                    <Button Content="信任"
                            Width="60" Height="28"
                            Margin="5,0"
                            Background="#27AE60"
                            Foreground="White"
                            Click="TrustThreat_Click"
                            Cursor="Hand"/>
                </StackPanel>
            </Grid>
            
            <!-- 列标题 -->
            <Grid Grid.Row="1" Margin="0,0,0,5" Background="{DynamicResource BgSecondary}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="文件名" FontWeight="Bold" Padding="5" Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock Grid.Column="1" Text="威胁类型" FontWeight="Bold" Padding="5" Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock Grid.Column="2" Text="风险等级" FontWeight="Bold" Padding="5" Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock Grid.Column="3" Text="置信度" FontWeight="Bold" Padding="5" Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock Grid.Column="4" Text="路径" FontWeight="Bold" Padding="5" Foreground="{DynamicResource TextPrimary}"/>
            </Grid>
            
            <!-- 威胁列表 -->
            <ListView x:Name="ScanResultsList"
                     Grid.Row="2"
                     Background="{DynamicResource BgTertiary}"
                     Foreground="{DynamicResource TextPrimary}"
                     BorderBrush="{DynamicResource BorderColor}"
                     BorderThickness="1"
                     SelectionMode="Single"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                     VirtualizingStackPanel.CacheLength="5,5">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" 
                                       Text="{Binding FileName}" 
                                       Padding="5" 
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding FilePath}"
                                       Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Grid.Column="1" 
                                       Text="{Binding ThreatType}" 
                                       Padding="5"
                                       Foreground="{DynamicResource TextSecondary}"/>
                            <TextBlock Grid.Column="2" 
                                       Text="{Binding Severity}" 
                                       Padding="5"
                                       FontWeight="Bold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Severity}" Value="严重">
                                                <Setter Property="Foreground" Value="#E74C3C"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Severity}" Value="高">
                                                <Setter Property="Foreground" Value="#E67E22"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Severity}" Value="中">
                                                <Setter Property="Foreground" Value="#F1C40F"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Severity}" Value="低">
                                                <Setter Property="Foreground" Value="#2ECC71"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Grid.Column="3" 
                                       Text="{Binding ConfidencePercent}" 
                                       Padding="5"
                                       Foreground="{DynamicResource TextSecondary}"/>
                            <TextBlock Grid.Column="4" 
                                       Text="{Binding FilePath}" 
                                       Padding="5"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding FilePath}"
                                       Foreground="{DynamicResource TextSecondary}"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
