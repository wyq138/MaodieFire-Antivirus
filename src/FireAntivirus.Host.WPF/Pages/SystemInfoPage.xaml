<Page x:Class="FireAntivirus.Host.WPF.Pages.SystemInfoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="系统信息">
    
    <Grid x:Name="MainGrid" Background="{DynamicResource BgPrimary}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- 标题区域 -->
        <Grid Grid.Row="0" Margin="20,15">
            <TextBlock x:Name="TitleText" 
                       Text="系统信息" 
                       FontSize="18" 
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimary}"/>
        </Grid>
        
        <!-- 内容区域 -->
        <ScrollViewer Grid.Row="1" Margin="20,0,20,20">
            <StackPanel x:Name="InfoPanel">
                <!-- 操作系统信息 -->
                <Border x:Name="OSPanel"
                        Background="{DynamicResource CardBg}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="0,0,0,15"
                        Padding="15">
                    <StackPanel>
                        <TextBlock Text="操作系统信息" 
                                   FontSize="14" 
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   Margin="0,0,0,10"/>
                        <TextBlock x:Name="OSNameLabel" 
                                   Text="操作系统: 正在加载..."
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Margin="0,0,0,5"/>
                        <TextBlock x:Name="OSVersionLabel" 
                                   Text="版本: 正在加载..."
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Margin="0,0,0,5"/>
                        <TextBlock x:Name="OSArchLabel" 
                                   Text="架构: 正在加载..."
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Margin="0,0,0,5"/>
                        <TextBlock x:Name="OSInstallDateLabel" 
                                   Text="安装日期: 正在加载..."
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Margin="0,0,0,5"/>
                        <TextBlock x:Name="OSSystemDirLabel" 
                                   Text="系统目录: 正在加载..."
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>
                </Border>
                
                <!-- 处理器信息 -->
                <Border x:Name="CPUPanel"
                        Background="{DynamicResource CardBg}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="0,0,0,15"
                        Padding="15">
                    <StackPanel>
                        <TextBlock Text="处理器信息" 
                                   FontSize="14" 
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   Margin="0,0,0,10"/>
                        <TextBlock x:Name="CPUNameLabel" 
                                   Text="处理器: 正在加载..."
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Margin="0,0,0,5"/>
                        <TextBlock x:Name="CPUManufacturerLabel" 
                                   Text="制造商: 正在加载..."
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Margin="0,0,0,5"/>
                        <TextBlock x:Name="CPUCoresLabel" 
                                   Text="核心数: 正在加载..."
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Margin="0,0,0,5"/>
                        <TextBlock x:Name="CPULogicalLabel" 
                                   Text="逻辑处理器: 正在加载..."
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Margin="0,0,0,5"/>
                        <TextBlock x:Name="CPUSpeedLabel" 
                                   Text="最大时钟速度: 正在加载..."
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>
                </Border>
                
                <!-- 内存信息 -->
                <Border x:Name="MemoryPanel"
                        Background="{DynamicResource CardBg}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="0,0,0,15"
                        Padding="15">
                    <StackPanel>
                        <TextBlock Text="内存信息" 
                                   FontSize="14" 
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   Margin="0,0,0,10"/>
                        <TextBlock x:Name="MemoryTotalLabel" 
                                   Text="物理内存: 正在加载..."
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Margin="0,0,0,5"/>
                        <TextBlock x:Name="MemoryAvailableLabel" 
                                   Text="可用内存: 正在加载..."
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Margin="0,0,0,5"/>
                        <TextBlock x:Name="MemoryUsageLabel" 
                                   Text="内存使用率: 正在加载..."
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Margin="0,0,0,5"/>
                        <TextBlock x:Name="MemoryVisibleLabel" 
                                   Text="总可见内存: 正在加载..."
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Margin="0,0,0,5"/>
                        <TextBlock x:Name="MemoryFreeLabel" 
                                   Text="可用物理内存: 正在加载..."
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>
                </Border>
                
                <!-- 磁盘信息 -->
                <Border x:Name="DiskPanel"
                        Background="{DynamicResource CardBg}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="0,0,0,15"
                        Padding="15">
                    <StackPanel>
                        <TextBlock Text="磁盘信息" 
                                   FontSize="14" 
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   Margin="0,0,0,10"/>
                        <TextBlock x:Name="Disk1Label" 
                                   Text="磁盘1: 正在加载..."
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Margin="0,0,0,5"/>
                        <TextBlock x:Name="Disk2Label" 
                                   Text="磁盘2: 正在加载..."
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Margin="0,0,0,5"/>
                        <TextBlock x:Name="Disk3Label" 
                                   Text="磁盘3: 正在加载..."
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Margin="0,0,0,5"/>
                        <TextBlock x:Name="Disk4Label" 
                                   Text="磁盘4: 正在加载..."
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Margin="0,0,0,5"/>
                        <TextBlock x:Name="Disk5Label" 
                                   Text=""
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>
                </Border>
                
                <!-- 系统信息 -->
                <Border x:Name="SystemPanel"
                        Background="{DynamicResource CardBg}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="0,0,0,15"
                        Padding="15">
                    <StackPanel>
                        <TextBlock Text="系统信息" 
                                   FontSize="14" 
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   Margin="0,0,0,10"/>
                        <TextBlock x:Name="SystemManufacturerLabel" 
                                   Text="制造商: 正在加载..."
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Margin="0,0,0,5"/>
                        <TextBlock x:Name="SystemModelLabel" 
                                   Text="型号: 正在加载..."
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Margin="0,0,0,5"/>
                        <TextBlock x:Name="SystemMemoryLabel" 
                                   Text="总物理内存: 正在加载..."
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Margin="0,0,0,5"/>
                        <TextBlock x:Name="SystemBootTimeLabel" 
                                   Text="上次启动时间: 正在加载..."
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Margin="0,0,0,5"/>
                        <TextBlock x:Name="SystemComputerNameLabel" 
                                   Text="计算机名: 正在加载..."
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
