<Page x:Class="FireAntivirus.Host.WPF.Pages.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="关于">
    
    <Grid x:Name="MainGrid" Background="{DynamicResource BgPrimary}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- 标题区域 -->
        <Grid Grid.Row="0" Margin="20,15">
            <TextBlock x:Name="TitleText" 
                       Text="关于 耄耋安全软件" 
                       FontSize="18" 
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimary}"/>
        </Grid>
        
        <!-- 内容区域 -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Logo区域 -->
            <Border Grid.Column="0"
                    Width="120"
                    Height="120"
                    Background="{DynamicResource CardBg}"
                    CornerRadius="10"
                    Margin="0,0,30,0"
                    VerticalAlignment="Top">
                <Viewbox Width="100" Height="100">
                    <Image Source="pack://application:,,,/Resources/cat_logo.png" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Viewbox>
            </Border>
            
            <!-- 信息区域 -->
            <StackPanel Grid.Column="1" VerticalAlignment="Top">
                <TextBlock x:Name="VersionLabel"
                           Text="版本: v1.0.0 正式版"
                           FontSize="14"
                           Foreground="{DynamicResource TextPrimary}"
                           Margin="0,0,0,15"/>
                
                <TextBlock x:Name="DeveloperLabel"
                           Text="开发者: 耄耋安全软件团队"
                           FontSize="14"
                           Foreground="{DynamicResource TextPrimary}"
                           Margin="0,0,0,15"/>
                
                <TextBlock x:Name="PhoneLabel"
                           Text="电话: 18281970402"
                           FontSize="14"
                           Foreground="{DynamicResource TextPrimary}"
                           Margin="0,0,0,15"/>
                
                <TextBlock x:Name="EmailLabel"
                           Text="意见/bug反馈邮箱: zjhwyq123456@qq.com"
                           FontSize="14"
                           Foreground="{DynamicResource TextPrimary}"
                           Margin="0,0,0,15"/>
                
                <TextBlock x:Name="DescriptionLabel"
                           Text="耄耋安全软件是一款功能强大的安全防护软件，提供实时防护、病毒扫描、网络防护等多种安全功能，全方位保护您的电脑安全。"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondary}"
                           TextWrapping="Wrap"
                           MaxWidth="400"
                           Margin="0,10,0,0"/>
            </StackPanel>
        </Grid>
        
        <!-- 版权信息 -->
        <TextBlock Grid.Row="2"
                   Text="© 2026 耄耋安全软件 保留所有权利"
                   FontSize="10"
                   Foreground="{DynamicResource TextDisabled}"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,15"/>
    </Grid>
</Page>
