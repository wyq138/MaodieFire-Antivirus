<Page x:Class="FireAntivirus.Host.WPF.Pages.NetworkTrafficAnalyzerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="网络流量分析">

    <Grid x:Name="MainGrid" Background="{DynamicResource BgPrimary}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题区域 -->
        <Grid Grid.Row="0" Margin="20,15">
            <TextBlock x:Name="TitleText" 
                       Text="网络流量分析" 
                       FontSize="18" 
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimary}"/>
        </Grid>

        <!-- 内容区域 -->
        <ScrollViewer Grid.Row="1" Margin="20,0,20,20" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 实时速度显示 -->
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 上传速度 -->
                    <Border Grid.Column="0"
                            Background="{DynamicResource CardBg}"
                            BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Margin="0,0,8,0"
                            Padding="20">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="上传速度" 
                                       FontSize="12" 
                                       Foreground="{DynamicResource TextSecondary}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock x:Name="UploadSpeedText"
                                       Text="0 KB/s"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryColor}"
                                       HorizontalAlignment="Center"
                                       Margin="0,8,0,0"/>
                            <TextBlock x:Name="UploadTotalText"
                                       Text="总计: 0 MB"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondary}"
                                       HorizontalAlignment="Center"
                                       Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 下载速度 -->
                    <Border Grid.Column="1"
                            Background="{DynamicResource CardBg}"
                            BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Margin="8,0,0,0"
                            Padding="20">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="下载速度" 
                                       FontSize="12" 
                                       Foreground="{DynamicResource TextSecondary}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock x:Name="DownloadSpeedText"
                                       Text="0 KB/s"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource SuccessColor}"
                                       HorizontalAlignment="Center"
                                       Margin="0,8,0,0"/>
                            <TextBlock x:Name="DownloadTotalText"
                                       Text="总计: 0 MB"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondary}"
                                       HorizontalAlignment="Center"
                                       Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 实时流量图表 -->
                <Border x:Name="ChartPanel"
                        Background="{DynamicResource CardBg}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="0,0,0,15"
                        Padding="15"
                        Height="200">
                    <Grid>
                        <TextBlock Text="实时流量图表" 
                                   FontSize="14" 
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   VerticalAlignment="Top"/>
                        <Canvas x:Name="TrafficChartCanvas" 
                                Margin="0,25,0,0"
                                Background="Transparent"/>
                        <!-- 图例 -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,0,0">
                            <TextBlock Text="— 上传" FontSize="10" Foreground="#4A90D9" Margin="0,0,15,0"/>
                            <TextBlock Text="— 下载" FontSize="10" Foreground="#2E7D32"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 应用流量列表 -->
                <Border x:Name="AppTrafficPanel"
                        Background="{DynamicResource CardBg}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="0,0,0,15"
                        Padding="15">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="应用程序流量" 
                                       FontSize="14" 
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimary}"
                                       VerticalAlignment="Center"/>
                            <Button x:Name="RefreshTrafficBtn"
                                    Content="刷新"
                                    Width="80"
                                    Height="30"
                                    HorizontalAlignment="Right"
                                    Background="{DynamicResource BgTertiary}"
                                    Foreground="{DynamicResource TextPrimary}"
                                    BorderBrush="{DynamicResource BorderColor}"
                                    BorderThickness="1"
                                    Cursor="Hand"
                                    Click="RefreshTraffic_Click"/>
                        </Grid>

                        <DataGrid x:Name="AppTrafficGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  Background="{DynamicResource BgTertiary}"
                                  Foreground="{DynamicResource TextPrimary}"
                                  BorderBrush="{DynamicResource BorderColor}"
                                  BorderThickness="1"
                                  GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  MinHeight="200">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="应用程序" Binding="{Binding AppName}" Width="*"/>
                                <DataGridTextColumn Header="上传" Binding="{Binding Upload}" Width="100"/>
                                <DataGridTextColumn Header="下载" Binding="{Binding Download}" Width="100"/>
                                <DataGridTextColumn Header="连接数" Binding="{Binding Connections}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- 流量历史 -->
                <Border x:Name="HistoryPanel"
                        Background="{DynamicResource CardBg}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="0,0,0,15"
                        Padding="15">
                    <StackPanel>
                        <TextBlock Text="流量历史" 
                                   FontSize="14" 
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="今日流量:" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="1" x:Name="TodayTrafficText" Text="256 MB" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryColor}" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="本周流量:" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="1" x:Name="WeekTrafficText" Text="1.8 GB" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryColor}" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="本月流量:" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="1" x:Name="MonthTrafficText" Text="12.5 GB" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryColor}" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 告警设置 -->
                <Border x:Name="AlertSettingsPanel"
                        Background="{DynamicResource CardBg}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="0,0,0,15"
                        Padding="15">
                    <StackPanel>
                        <TextBlock Text="告警设置" 
                                   FontSize="14" 
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   Margin="0,0,0,15"/>

                        <!-- 流量阈值告警 -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="启用流量阈值告警" FontSize="12" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                            <CheckBox Grid.Column="1" x:Name="ThresholdAlertCheck" IsChecked="True"/>
                        </Grid>

                        <!-- 阈值设置 -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="流量阈值:" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox Grid.Column="1" x:Name="ThresholdValue" Text="1000" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="MB/天" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- 异常流量告警 -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="异常流量告警" FontSize="12" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                            <CheckBox Grid.Column="1" x:Name="AnomalyAlertCheck" IsChecked="True"/>
                        </Grid>

                        <!-- 新连接通知 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="新连接通知" FontSize="12" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                            <CheckBox Grid.Column="1" x:Name="NewConnectionCheck" IsChecked="False"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 控制按钮 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="StartMonitorBtn"
                            Grid.Column="0"
                            Content="开始监控"
                            Height="40"
                            Margin="0,0,8,0"
                            Background="{DynamicResource PrimaryColor}"
                            Foreground="White"
                            FontSize="13"
                            Cursor="Hand"
                            Click="StartMonitor_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button x:Name="StopMonitorBtn"
                            Grid.Column="1"
                            Content="停止监控"
                            Height="40"
                            Margin="8,0,0,0"
                            Background="{DynamicResource BgTertiary}"
                            Foreground="{DynamicResource TextPrimary}"
                            BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1"
                            FontSize="13"
                            Cursor="Hand"
                            Click="StopMonitor_Click"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
