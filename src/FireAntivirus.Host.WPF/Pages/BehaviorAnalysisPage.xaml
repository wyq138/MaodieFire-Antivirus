<Page x:Class="FireAntivirus.Host.WPF.Pages.BehaviorAnalysisPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="行为分析">
    <Grid x:Name="MainGrid" Background="{DynamicResource BgPrimary}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="20,15">
            <TextBlock x:Name="TitleText" Text="行为分析" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
        </Grid>
        <ScrollViewer Grid.Row="1" Margin="20,0,20,20">
            <StackPanel>
                <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,15" Padding="15">
                    <StackPanel>
                        <TextBlock Text="👁️ 行为监控状态" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10"/>
                        <TextBlock x:Name="StatusText" Text="状态: 监控中" FontSize="12" Foreground="Green"/>
                        <TextBlock x:Name="ProcessesMonitored" Text="监控进程: 0 个" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,15" Padding="15">
                    <StackPanel>
                        <TextBlock Text="⚙️ 监控选项" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10"/>
                        <CheckBox x:Name="EnableBehaviorMonitor" Content="启用行为监控" IsChecked="True" Margin="0,5"/>
                        <CheckBox x:Name="EnableBaselineLearning" Content="启用基线学习" IsChecked="True" Margin="0,5"/>
                        <CheckBox x:Name="EnableMLDetection" Content="启用机器学习检测" IsChecked="True" Margin="0,5"/>
                        <CheckBox x:Name="EnableRealTimeBlocking" Content="启用实时拦截" IsChecked="True" Margin="0,5"/>
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,15" Padding="15">
                    <StackPanel>
                        <TextBlock Text="⚠️ 可疑行为警报" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10"/>
                        <DataGrid x:Name="AlertsGrid" AutoGenerateColumns="False" IsReadOnly="True" Height="150">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="进程" Binding="{Binding ProcessName}" Width="*"/>
                                <DataGridTextColumn Header="行为" Binding="{Binding Behavior}" Width="120"/>
                                <DataGridTextColumn Header="风险" Binding="{Binding Risk}" Width="60"/>
                                <DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,15" Padding="15">
                    <StackPanel>
                        <TextBlock Text="📊 统计数据" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock x:Name="TotalEvents" Text="0" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryColor}"/>
                                <TextBlock Text="事件总数" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <TextBlock x:Name="ThreatsDetected" Text="0" FontSize="20" FontWeight="Bold" Foreground="Orange"/>
                                <TextBlock Text="威胁检测" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <TextBlock x:Name="ProcessesBlocked" Text="0" FontSize="20" FontWeight="Bold" Foreground="Red"/>
                                <TextBlock Text="进程拦截" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
