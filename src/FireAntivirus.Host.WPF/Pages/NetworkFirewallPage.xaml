<Page x:Class="FireAntivirus.Host.WPF.Pages.NetworkFirewallPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="网络防火墙">

    <Grid x:Name="MainGrid" Background="{DynamicResource BgPrimary}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- 标题区域 -->
        <Grid Grid.Row="0" Margin="20,15">
            <TextBlock x:Name="TitleText" 
                       Text="网络防火墙" 
                       FontSize="18" 
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimary}"/>
        </Grid>
        
        <!-- 内容区域 -->
        <ScrollViewer Grid.Row="1" Margin="20,0,20,20">
            <StackPanel>
                <!-- 防火墙状态卡片 -->
                <Border Background="{DynamicResource CardBg}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="0,0,0,15"
                        Padding="15">
                    <StackPanel>
                        <TextBlock Text="🔥 防火墙状态" 
                                   FontSize="14" 
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   Margin="0,0,0,10"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" 
                                       Text="防火墙：" 
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimary}"
                                       Margin="0,0,10,0"/>
                            
                            <TextBlock x:Name="FirewallStatusText" 
                                       Grid.Column="1"
                                       Text="已启用" 
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="Green"/>
                            
                            <ToggleButton x:Name="FirewallToggle" 
                                          Grid.Column="2"
                                          Content="关闭" 
                                          Width="80" 
                                          Height="28"
                                          Background="{DynamicResource PrimaryColor}"
                                          Foreground="White"
                                          BorderThickness="0"
                                          Cursor="Hand"/>
                        </Grid>
                    </StackPanel>
                </Border>
                
                <!-- 活动连接卡片 -->
                <Border Background="{DynamicResource CardBg}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="0,0,0,15"
                        Padding="15">
                    <StackPanel>
                        <TextBlock Text="🔌 活动连接" 
                                   FontSize="14" 
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   Margin="0,0,0,10"/>
                        
                        <DataGrid x:Name="ActiveConnectionsGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  Height="150"
                                  Background="{DynamicResource BgTertiary}"
                                  Foreground="{DynamicResource TextPrimary}"
                                  BorderBrush="{DynamicResource BorderColor}"
                                  BorderThickness="1"
                                  GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="进程" Binding="{Binding ProcessName}" Width="100"/>
                                <DataGridTextColumn Header="本地地址" Binding="{Binding LocalAddress}" Width="120"/>
                                <DataGridTextColumn Header="远程地址" Binding="{Binding RemoteAddress}" Width="120"/>
                                <DataGridTextColumn Header="端口" Binding="{Binding Port}" Width="60"/>
                                <DataGridTextColumn Header="协议" Binding="{Binding Protocol}" Width="60"/>
                                <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        
                        <Button x:Name="RefreshConnectionsBtn" 
                                Content="刷新连接" 
                                Width="100" 
                                Height="28"
                                Margin="0,10,0,0"
                                Background="{DynamicResource BgTertiary}"
                                Foreground="{DynamicResource TextPrimary}"
                                BorderBrush="{DynamicResource BorderColor}"
                                BorderThickness="1"
                                Cursor="Hand"
                                HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>
                
                <!-- 防火墙规则卡片 -->
                <Border Background="{DynamicResource CardBg}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="0,0,0,15"
                        Padding="15">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="📋 防火墙规则" 
                                       FontSize="14" 
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimary}"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"/>
                            
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="AddRuleBtn" 
                                        Content="添加规则" 
                                        Width="80" 
                                        Height="28"
                                        Margin="0,0,5,0"
                                        Background="{DynamicResource BgTertiary}"
                                        Foreground="{DynamicResource TextPrimary}"
                                        BorderBrush="{DynamicResource BorderColor}"
                                        BorderThickness="1"
                                        Cursor="Hand"/>
                                <Button x:Name="RemoveRuleBtn" 
                                        Content="移除规则" 
                                        Width="80" 
                                        Height="28"
                                        Background="{DynamicResource BgTertiary}"
                                        Foreground="{DynamicResource TextPrimary}"
                                        BorderBrush="{DynamicResource BorderColor}"
                                        BorderThickness="1"
                                        Cursor="Hand"/>
                            </StackPanel>
                        </Grid>
                        
                        <ListBox x:Name="RulesListBox" 
                                 Height="150"
                                 Background="{DynamicResource BgTertiary}"
                                 Foreground="{DynamicResource TextPrimary}"
                                 BorderBrush="{DynamicResource BorderColor}"/>
                    </StackPanel>
                </Border>
                
                <!-- 入侵检测统计卡片 -->
                <Border Background="{DynamicResource CardBg}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="0,0,0,15"
                        Padding="15">
                    <StackPanel>
                        <TextBlock Text="📊 入侵检测统计" 
                                   FontSize="14" 
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   Margin="0,0,0,10"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <Border Grid.Column="0"
                                    Background="{DynamicResource BgTertiary}"
                                    BorderBrush="{DynamicResource BorderColor}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10"
                                    Margin="0,0,10,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="今日拦截" 
                                               FontSize="11"
                                               Foreground="{DynamicResource TextSecondary}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TodayBlockedText" 
                                               Text="0" 
                                               FontSize="24"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryColor}"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            
                            <Border Grid.Column="1"
                                    Background="{DynamicResource BgTertiary}"
                                    BorderBrush="{DynamicResource BorderColor}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10"
                                    Margin="5,0,5,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="本周拦截" 
                                               FontSize="11"
                                               Foreground="{DynamicResource TextSecondary}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="WeekBlockedText" 
                                               Text="0" 
                                               FontSize="24"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryColor}"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            
                            <Border Grid.Column="2"
                                    Background="{DynamicResource BgTertiary}"
                                    BorderBrush="{DynamicResource BorderColor}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10"
                                    Margin="10,0,0,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="总计拦截" 
                                               FontSize="11"
                                               Foreground="{DynamicResource TextSecondary}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TotalBlockedText" 
                                               Text="0" 
                                               FontSize="24"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryColor}"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <Border Grid.Column="0"
                                    Background="{DynamicResource BgTertiary}"
                                    BorderBrush="{DynamicResource BorderColor}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10"
                                    Margin="0,0,5,0">
                                <StackPanel>
                                    <TextBlock Text="端口扫描攻击" 
                                               FontSize="11"
                                               Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock x:Name="PortScanCountText" 
                                               Text="0 次" 
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimary}"/>
                                </StackPanel>
                            </Border>
                            
                            <Border Grid.Column="1"
                                    Background="{DynamicResource BgTertiary}"
                                    BorderBrush="{DynamicResource BorderColor}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10"
                                    Margin="5,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="DDoS 攻击" 
                                               FontSize="11"
                                               Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock x:Name="DDoSCountText" 
                                               Text="0 次" 
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimary}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
