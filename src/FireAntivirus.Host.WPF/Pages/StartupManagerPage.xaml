<Page x:Class="FireAntivirus.Host.WPF.Pages.StartupManagerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="启动管理">

    <Grid x:Name="MainGrid" Background="{DynamicResource BgPrimary}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题区域 -->
        <Grid Grid.Row="0" Margin="20,15">
            <TextBlock x:Name="TitleText" 
                       Text="启动管理" 
                       FontSize="18" 
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimary}"/>
        </Grid>

        <!-- 内容区域 -->
        <Grid Grid.Row="1" Margin="20,0,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 统计信息 -->
            <Border Grid.Row="0"
                    Background="{DynamicResource CardBg}"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Margin="0,0,0,15"
                    Padding="15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                        <TextBlock Text="启动项总数" FontSize="12" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TotalStartupText" Text="24" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource PrimaryColor}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                        <TextBlock Text="已启用" FontSize="12" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="EnabledStartupText" Text="18" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource SuccessColor}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                        <TextBlock Text="已禁用" FontSize="12" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="DisabledStartupText" Text="6" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextDisabled}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 启动项列表 -->
            <Border Grid.Row="1"
                    Background="{DynamicResource CardBg}"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 控制按钮 -->
                    <Grid Grid.Row="0" Margin="0,0,0,15">
                        <TextBlock Text="启动项列表" 
                                   FontSize="14" 
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="AddStartupBtn"
                                    Content="添加启动项"
                                    Width="100"
                                    Height="32"
                                    Margin="0,0,10,0"
                                    Background="{DynamicResource PrimaryColor}"
                                    Foreground="White"
                                    Cursor="Hand"
                                    Click="AddStartup_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button x:Name="RefreshStartupBtn"
                                    Content="刷新"
                                    Width="70"
                                    Height="32"
                                    Margin="0,0,10,0"
                                    Background="{DynamicResource BgTertiary}"
                                    Foreground="{DynamicResource TextPrimary}"
                                    BorderBrush="{DynamicResource BorderColor}"
                                    BorderThickness="1"
                                    Cursor="Hand"
                                    Click="RefreshStartup_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- 启动项DataGrid -->
                    <DataGrid x:Name="StartupGrid"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              Background="{DynamicResource BgTertiary}"
                              Foreground="{DynamicResource TextPrimary}"
                              BorderBrush="{DynamicResource BorderColor}"
                              BorderThickness="1"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="180"/>
                            <DataGridTextColumn Header="发布者" Binding="{Binding Publisher}" Width="120"/>
                            <DataGridTextColumn Header="路径" Binding="{Binding Path}" Width="*"/>
                            <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="80"/>
                            <DataGridTextColumn Header="影响" Binding="{Binding Impact}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- 操作按钮 -->
                    <Grid Grid.Row="2" Margin="0,15,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="EnableBtn"
                                Grid.Column="0"
                                Content="启用"
                                Height="36"
                                Margin="0,0,10,0"
                                Background="{DynamicResource SuccessColor}"
                                Foreground="White"
                                FontSize="13"
                                Cursor="Hand"
                                Click="EnableStartup_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button x:Name="DisableBtn"
                                Grid.Column="1"
                                Content="禁用"
                                Height="36"
                                Margin="10,0,10,0"
                                Background="{DynamicResource WarningColor}"
                                Foreground="White"
                                FontSize="13"
                                Cursor="Hand"
                                Click="DisableStartup_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button x:Name="DeleteBtn"
                                Grid.Column="2"
                                Content="删除"
                                Height="36"
                                Margin="10,0,0,0"
                                Background="{DynamicResource ErrorColor}"
                                Foreground="White"
                                FontSize="13"
                                Cursor="Hand"
                                Click="DeleteStartup_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
