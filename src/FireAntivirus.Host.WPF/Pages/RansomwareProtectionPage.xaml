<Page x:Class="FireAntivirus.Host.WPF.Pages.RansomwareProtectionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="勒索防护">

    <Grid x:Name="MainGrid" Background="{DynamicResource BgPrimary}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- 标题区域 -->
        <Grid Grid.Row="0" Margin="20,15">
            <TextBlock x:Name="TitleText" 
                       Text="勒索防护" 
                       FontSize="18" 
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimary}"/>
        </Grid>
        
        <!-- 内容区域 -->
        <ScrollViewer Grid.Row="1" Margin="20,0,20,20">
            <StackPanel>
                <!-- 防护状态卡片 -->
                <Border Background="{DynamicResource CardBg}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="0,0,0,15"
                        Padding="15">
                    <StackPanel>
                        <TextBlock Text="🛡️ 勒索防护状态" 
                                   FontSize="14" 
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   Margin="0,0,0,10"/>
                        <TextBlock x:Name="StatusText" 
                                   Text="防护已启用" 
                                   FontSize="12"
                                   Foreground="Green"
                                   Margin="0,0,0,5"/>
                        <TextBlock Text="实时监控文件加密行为，防止勒索病毒加密您的文档" 
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>
                </Border>
                
                <!-- 功能列表 -->
                <Border Background="{DynamicResource CardBg}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="0,0,0,15"
                        Padding="15">
                    <StackPanel>
                        <TextBlock Text="📋 防护功能" 
                                   FontSize="14" 
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   Margin="0,0,0,10"/>
                        
                        <CheckBox x:Name="FileEncryptionCheck" Content="文件加密监控" IsChecked="True" Margin="0,5"/>
                        <CheckBox x:Name="BatchModifyCheck" Content="批量文件修改监控" IsChecked="True" Margin="0,5"/>
                        <CheckBox x:Name="ShadowCopyCheck" Content="影子副本保护" IsChecked="True" Margin="0,5"/>
                        <CheckBox x:Name="DecoyFileCheck" Content="诱饵文件检测" IsChecked="True" Margin="0,5"/>
                    </StackPanel>
                </Border>
                
                <!-- 受保护文件夹 -->
                <Border Background="{DynamicResource CardBg}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="0,0,0,15"
                        Padding="15">
                    <StackPanel>
                        <TextBlock Text="📁 受保护文件夹" 
                                   FontSize="14" 
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   Margin="0,0,0,10"/>
                        
                        <ListBox x:Name="ProtectedFoldersList" Height="120" Margin="0,0,0,10"/>
                        
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="AddFolderBtn" Content="添加文件夹" Width="100" Height="28" Margin="0,0,10,0" Click="AddFolder_Click"/>
                            <Button x:Name="RemoveFolderBtn" Content="移除" Width="80" Height="28" Click="RemoveFolder_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                
                <!-- 操作按钮 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="StartProtectionBtn" 
                            Content="启动防护" 
                            Width="100" 
                            Height="35"
                            Background="{DynamicResource PrimaryColor}"
                            Foreground="White"
                            BorderThickness="0"
                            Click="StartProtection_Click"
                            Margin="0,0,10,0"/>
                    <Button x:Name="StopProtectionBtn" 
                            Content="停止防护" 
                            Width="100" 
                            Height="35"
                            Background="{DynamicResource WarningColor}"
                            Foreground="White"
                            BorderThickness="0"
                            Click="StopProtection_Click"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
