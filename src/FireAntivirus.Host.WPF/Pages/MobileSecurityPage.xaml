<Page x:Class="FireAntivirus.Host.WPF.Pages.MobileSecurityPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="移动安全">
    <Grid x:Name="MainGrid" Background="{DynamicResource BgPrimary}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="20,15">
            <TextBlock x:Name="TitleText" Text="移动安全" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
        </Grid>
        <ScrollViewer Grid.Row="1" Margin="20,0,20,20">
            <StackPanel>
                <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,15" Padding="15">
                    <StackPanel>
                        <TextBlock Text="📱 移动设备安全" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10"/>
                        <TextBlock x:Name="StatusText" Text="状态: 监控中" FontSize="12" Foreground="Green"/>
                        <TextBlock Text="监控通过USB连接的Android/iOS设备" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,15" Padding="15">
                    <StackPanel>
                        <TextBlock Text="🔌 已连接设备" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10"/>
                        <DataGrid x:Name="MobileDevicesGrid" AutoGenerateColumns="False" IsReadOnly="True" Height="120">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="设备名称" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="80"/>
                                <DataGridTextColumn Header="信任状态" Binding="{Binding TrustStatus}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,15" Padding="15">
                    <StackPanel>
                        <TextBlock Text="📁 文件传输监控" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10"/>
                        <CheckBox x:Name="MonitorTransfers" Content="监控文件传输" IsChecked="True" Margin="0,5"/>
                        <CheckBox x:Name="ScanTransfers" Content="扫描传输文件" IsChecked="True" Margin="0,5"/>
                        <CheckBox x:Name="BlockSensitive" Content="阻止敏感文件传输" IsChecked="True" Margin="0,5"/>
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,15" Padding="15">
                    <StackPanel>
                        <TextBlock Text="🔒 隐私保护" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10"/>
                        <CheckBox x:Name="BlockAppInstall" Content="阻止非信任应用安装" Margin="0,5"/>
                        <CheckBox x:Name="BlockUSBDebug" Content="阻止USB调试" Margin="0,5"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
