<Page x:Class="FireAntivirus.Host.WPF.Pages.PerformanceDiagnosticsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="性能诊断">
    <Grid Background="White" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- 标题 -->
        <TextBlock Grid.Row="0" Text="性能诊断和优化建议" 
                   FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>
        
        <!-- 性能概览 -->
        <Border Grid.Row="1" BorderBrush="LightGray" BorderThickness="1" 
                Background="#F5F5F5" Margin="0,0,0,20" Padding="15">
            <StackPanel>
                <TextBlock Text="性能概览" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="整体性能:" FontWeight="Bold"/>
                    <TextBlock Grid.Column="1" Text="{Binding OverallPerformance}" Margin="10,0,20,0" 
                               Foreground="{Binding OverallPerformanceColor}"/>
                    <TextBlock Grid.Column="2" Text="平均加载时间:" FontWeight="Bold"/>
                    <TextBlock Grid.Column="3" Text="{Binding AverageLoadTimeMs}" Margin="10,0,0,0"/>
                </Grid>
                <Grid Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="最慢页面:" FontWeight="Bold"/>
                    <TextBlock Grid.Column="1" Text="{Binding WorstPerformingPage}" Margin="10,0,20,0"/>
                    <TextBlock Grid.Column="2" Text="最快页面:" FontWeight="Bold"/>
                    <TextBlock Grid.Column="3" Text="{Binding BestPerformingPage}" Margin="10,0,0,0"/>
                </Grid>
            </StackPanel>
        </Border>
        
        <!-- 页面性能详情 -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,20">
            <ItemsControl ItemsSource="{Binding PagePerformanceList}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel VirtualizingStackPanel.IsVirtualizing="True"
                                               VirtualizingStackPanel.VirtualizationMode="Recycling"
                                               VirtualizingStackPanel.CacheLength="5,5"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="LightGray" BorderThickness="1" 
                                Background="White" Margin="0,0,0,10" Padding="15">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding PageName}" FontWeight="Bold" FontSize="14"/>
                                    <Grid Margin="0,5,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="平均:" FontWeight="Bold"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding AverageTime, StringFormat={}{0}ms}" Margin="5,0,10,0"/>
                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="最大:" FontWeight="Bold"/>
                                        <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding MaxTime, StringFormat={}{0}ms}" Margin="5,0,0,0"/>
                                        
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="最小:" FontWeight="Bold"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding MinTime, StringFormat={}{0}ms}" Margin="5,0,10,0"/>
                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="95%值:" FontWeight="Bold"/>
                                        <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding Percentile95Time, StringFormat={}{0}ms}" Margin="5,0,0,0"/>
                                    </Grid>
                                    <TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}" Margin="0,5,0,0"/>
                                </StackPanel>
                                
                                <Button Grid.Column="1" Content="优化建议" 
                                       Command="{Binding DataContext.ShowOptimizationCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                       CommandParameter="{Binding PageName}"
                                       Margin="10,0,0,0" Width="80" Height="25"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        
        <!-- 操作按钮 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="刷新数据" Command="{Binding RefreshCommand}" 
                    Width="100" Height="30" Margin="0,0,10,0"/>
            <Button Content="生成报告" Command="{Binding GenerateReportCommand}" 
                    Width="100" Height="30" Margin="10,0,0,0"/>
        </StackPanel>
    </Grid>
</Page>