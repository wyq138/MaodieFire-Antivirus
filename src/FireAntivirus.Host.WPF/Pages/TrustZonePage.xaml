<Page x:Class="FireAntivirus.Host.WPF.Pages.TrustZonePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="信任区">
    
    <Grid x:Name="MainGrid" Background="{DynamicResource BgPrimary}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- 标题区域 -->
        <Grid Grid.Row="0" Margin="20,15">
            <TextBlock x:Name="TitleText" 
                       Text="信任区" 
                       FontSize="18" 
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimary}"/>
        </Grid>
        
        <!-- 内容区域 -->
        <Grid Grid.Row="1" Margin="20,0,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- 控制按钮区域 -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                <Button x:Name="AddFileBtn"
                        Content="添加文件"
                        Width="100"
                        Height="40"
                        Margin="0,0,10,0"
                        Background="{DynamicResource BgTertiary}"
                        Foreground="{DynamicResource TextPrimary}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        Click="AddTrustFile_Click"
                        Cursor="Hand"/>
                
                <Button x:Name="AddFolderBtn"
                        Content="添加文件夹"
                        Width="100"
                        Height="40"
                        Margin="10,0,10,0"
                        Background="{DynamicResource BgTertiary}"
                        Foreground="{DynamicResource TextPrimary}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        Click="AddTrustFolder_Click"
                        Cursor="Hand"/>
                
                <Button x:Name="DeleteBtn"
                        Content="删除信任项"
                        Width="100"
                        Height="40"
                        Margin="10,0,0,0"
                        Background="{DynamicResource BgTertiary}"
                        Foreground="{DynamicResource TextPrimary}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        Click="DeleteTrustItem_Click"
                        Cursor="Hand"/>
            </StackPanel>
            
            <!-- 信任列表 -->
            <DataGrid x:Name="TrustListGrid"
                      Grid.Row="1"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      Background="{DynamicResource BgTertiary}"
                      Foreground="{DynamicResource TextPrimary}"
                      BorderBrush="{DynamicResource BorderColor}"
                      BorderThickness="1"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="100"/>
                    <DataGridTextColumn Header="路径" Binding="{Binding Path}" Width="*"/>
                    <DataGridTextColumn Header="添加时间" Binding="{Binding AddTime}" Width="150"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</Page>
