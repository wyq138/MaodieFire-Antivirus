<Page x:Class="FireAntivirus.Host.WPF.Pages.NetworkPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="网络防护">
    
    <Grid x:Name="MainGrid" Background="{DynamicResource BgPrimary}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- 标题区域 -->
        <Grid Grid.Row="0" Margin="20,15">
            <TextBlock x:Name="TitleText" 
                       Text="网络防护" 
                       FontSize="18" 
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimary}"/>
        </Grid>
        
        <!-- 控制按钮区域 -->
        <Grid Grid.Row="1" Margin="20,0,20,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <Button x:Name="NetworkScanBtn"
                    Grid.Column="0"
                    Content="网络检测"
                    Height="40"
                    Margin="0,0,10,0"
                    Background="{DynamicResource BgTertiary}"
                    Foreground="{DynamicResource TextPrimary}"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1"
                    Click="NetworkScan_Click"
                    Cursor="Hand"/>
            
            <Button x:Name="BlockBtn"
                    Grid.Column="1"
                    Content="禁止联网"
                    Height="40"
                    Margin="5,0,5,0"
                    Background="{DynamicResource BgTertiary}"
                    Foreground="{DynamicResource TextPrimary}"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1"
                    Click="BlockSelectedApp_Click"
                    Cursor="Hand"/>
            
            <Button x:Name="AllowBtn"
                    Grid.Column="2"
                    Content="允许联网"
                    Height="40"
                    Margin="10,0,0,0"
                    Background="{DynamicResource BgTertiary}"
                    Foreground="{DynamicResource TextPrimary}"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1"
                    Click="AllowSelectedApp_Click"
                    Cursor="Hand"/>
        </Grid>
        
        <!-- 网络应用列表区域 -->
        <Grid Grid.Row="2" Margin="20,0,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <TextBlock x:Name="StatusLabel" 
                       Grid.Row="0"
                       Text="点击网络检测按钮开始检测网络状态" 
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondary}"
                       Margin="0,0,0,10"/>
            
            <DataGrid x:Name="NetworkAppsGrid"
                      Grid.Row="1"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      Background="{DynamicResource BgTertiary}"
                      Foreground="{DynamicResource TextPrimary}"
                      BorderBrush="{DynamicResource BorderColor}"
                      BorderThickness="1"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="应用名称" Binding="{Binding AppName}" Width="150"/>
                    <DataGridTextColumn Header="路径" Binding="{Binding Path}" Width="*"/>
                    <DataGridTextColumn Header="上传速度" Binding="{Binding Upload}" Width="80"/>
                    <DataGridTextColumn Header="下载速度" Binding="{Binding Download}" Width="80"/>
                    <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="80"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</Page>
