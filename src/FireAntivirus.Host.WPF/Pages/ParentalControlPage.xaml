<Page x:Class="FireAntivirus.Host.WPF.Pages.ParentalControlPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="家长控制">

    <Grid x:Name="MainGrid" Background="{DynamicResource BgPrimary}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- 标题区域 -->
        <Grid Grid.Row="0" Margin="20,15">
            <TextBlock x:Name="TitleText" 
                       Text="家长控制" 
                       FontSize="18" 
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimary}"/>
        </Grid>
        
        <!-- 内容区域 -->
        <ScrollViewer Grid.Row="1" Margin="20,0,20,20">
            <StackPanel>
                <!-- 用户管理卡片 -->
                <Border Background="{DynamicResource CardBg}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="0,0,0,15"
                        Padding="15">
                    <StackPanel>
                        <TextBlock Text="👤 用户管理" 
                                   FontSize="14" 
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   Margin="0,0,0,10"/>
                        
                        <ListBox x:Name="UsersListBox" 
                                 Height="120" 
                                 Margin="0,0,0,10"
                                 Background="{DynamicResource BgTertiary}"
                                 Foreground="{DynamicResource TextPrimary}"
                                 BorderBrush="{DynamicResource BorderColor}"/>
                        
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="AddUserBtn" 
                                    Content="添加用户" 
                                    Width="100" 
                                    Height="28" 
                                    Margin="0,0,10,0"
                                    Background="{DynamicResource BgTertiary}"
                                    Foreground="{DynamicResource TextPrimary}"
                                    BorderBrush="{DynamicResource BorderColor}"
                                    BorderThickness="1"
                                    Cursor="Hand"/>
                            <Button x:Name="RemoveUserBtn" 
                                    Content="移除用户" 
                                    Width="100" 
                                    Height="28"
                                    Background="{DynamicResource BgTertiary}"
                                    Foreground="{DynamicResource TextPrimary}"
                                    BorderBrush="{DynamicResource BorderColor}"
                                    BorderThickness="1"
                                    Cursor="Hand"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                
                <!-- 时间限制卡片 -->
                <Border Background="{DynamicResource CardBg}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="0,0,0,15"
                        Padding="15">
                    <StackPanel>
                        <TextBlock Text="⏰ 时间限制" 
                                   FontSize="14" 
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   Margin="0,0,0,10"/>
                        
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" 
                                       Text="每日使用时限：" 
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimary}"
                                       Margin="0,0,10,0"/>
                            <ComboBox x:Name="DailyLimitComboBox" 
                                      Grid.Column="1"
                                      Width="150"
                                      HorizontalAlignment="Left"
                                      Background="{DynamicResource BgTertiary}"
                                      Foreground="{DynamicResource TextPrimary}"
                                      BorderBrush="{DynamicResource BorderColor}">
                                <ComboBoxItem Content="无限制"/>
                                <ComboBoxItem Content="30分钟"/>
                                <ComboBoxItem Content="1小时"/>
                                <ComboBoxItem Content="2小时"/>
                                <ComboBoxItem Content="3小时"/>
                                <ComboBoxItem Content="4小时"/>
                            </ComboBox>
                        </Grid>
                        
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" 
                                       Text="允许使用时间段：" 
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimary}"
                                       Margin="0,0,10,0"/>
                            <TextBox x:Name="StartTimeTextBox" 
                                     Grid.Column="1"
                                     Text="08:00"
                                     VerticalAlignment="Center"
                                     Background="{DynamicResource BgTertiary}"
                                     Foreground="{DynamicResource TextPrimary}"
                                     BorderBrush="{DynamicResource BorderColor}"/>
                            <TextBlock Grid.Column="2" 
                                       Text=" 至 " 
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimary}"/>
                            <TextBox x:Name="EndTimeTextBox" 
                                     Grid.Column="3"
                                     Text="22:00"
                                     VerticalAlignment="Center"
                                     Background="{DynamicResource BgTertiary}"
                                     Foreground="{DynamicResource TextPrimary}"
                                     BorderBrush="{DynamicResource BorderColor}"/>
                        </Grid>
                    </StackPanel>
                </Border>
                
                <!-- 内容过滤卡片 -->
                <Border Background="{DynamicResource CardBg}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="0,0,0,15"
                        Padding="15">
                    <StackPanel>
                        <TextBlock Text="🛡️ 内容过滤" 
                                   FontSize="14" 
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   Margin="0,0,0,10"/>
                        
                        <CheckBox x:Name="BlockAdultContent" 
                                  Content="屏蔽成人内容" 
                                  IsChecked="True" 
                                  Margin="0,5"
                                  Foreground="{DynamicResource TextPrimary}"/>
                        <CheckBox x:Name="BlockGamblingContent" 
                                  Content="屏蔽赌博网站" 
                                  IsChecked="True" 
                                  Margin="0,5"
                                  Foreground="{DynamicResource TextPrimary}"/>
                        <CheckBox x:Name="BlockViolenceContent" 
                                  Content="屏蔽暴力内容" 
                                  IsChecked="True" 
                                  Margin="0,5"
                                  Foreground="{DynamicResource TextPrimary}"/>
                        <CheckBox x:Name="BlockSocialMedia" 
                                  Content="屏蔽社交媒体" 
                                  IsChecked="False" 
                                  Margin="0,5"
                                  Foreground="{DynamicResource TextPrimary}"/>
                        <CheckBox x:Name="BlockGames" 
                                  Content="屏蔽游戏网站" 
                                  IsChecked="False" 
                                  Margin="0,5"
                                  Foreground="{DynamicResource TextPrimary}"/>
                    </StackPanel>
                </Border>
                
                <!-- 保存按钮 -->
                <Button x:Name="SaveBtn" 
                        Content="保存设置" 
                        Width="120" 
                        Height="35"
                        Background="{DynamicResource PrimaryColor}"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        HorizontalAlignment="Left"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
