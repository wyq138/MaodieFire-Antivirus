<Page x:Class="FireAntivirus.Host.WPF.Pages.DonationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="捐赠支持">
    
    <Grid x:Name="MainGrid" Background="{DynamicResource BgPrimary}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <StackPanel Grid.Row="0" Margin="20">
            <TextBlock x:Name="TitleText" Text="支持耄耋安全软件" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
            <TextBlock x:Name="SubtitleText" Text="您的支持是我们持续改进的动力" FontSize="14" Foreground="{DynamicResource TextSecondary}" Margin="0,5,0,0"/>
        </StackPanel>
        
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20">
                <Border Background="{DynamicResource BgSecondary}" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="关于捐赠" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10"/>
                        <TextBlock Text="耄耋安全软件是一款免费的国产杀毒软件，致力于为用户提供专业、轻量、高效的安全防护。" 
                                   TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,10"/>
                        <TextBlock Text="您的捐赠将帮助我们：" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,5"/>
                        <TextBlock Text="• 持续更新病毒库，提升查杀能力" Foreground="{DynamicResource TextSecondary}" Margin="10,2"/>
                        <TextBlock Text="• 优化软件性能，降低资源占用" Foreground="{DynamicResource TextSecondary}" Margin="10,2"/>
                        <TextBlock Text="• 开发新功能，增强安全防护" Foreground="{DynamicResource TextSecondary}" Margin="10,2"/>
                        <TextBlock Text="• 维护服务器，保障云服务稳定" Foreground="{DynamicResource TextSecondary}" Margin="10,2"/>
                    </StackPanel>
                </Border>
                
                <Border Background="{DynamicResource BgSecondary}" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="捐赠方式" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,15"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                                    <Border Grid.Column="0" Background="{DynamicResource BgTertiary}" CornerRadius="6" Padding="15" Margin="0,0,10,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="扫码捐赠" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                    <Border Background="White" Width="280" Height="280" CornerRadius="4" Padding="8">
                                        <Image x:Name="QRCodeImage" Stretch="Uniform" />
                                    </Border>
                                    <TextBlock Text="支付宝 / 微信" FontSize="12" HorizontalAlignment="Center" Margin="0,10,0,0" Foreground="{DynamicResource TextSecondary}"/>
                                </StackPanel>
                            </Border>
                            
                            <Border Grid.Column="1" Background="{DynamicResource BgTertiary}" CornerRadius="6" Padding="15" Margin="10,0,0,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="联系方式" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                    <Border Background="{DynamicResource BgSecondary}" Width="180" Height="180" CornerRadius="4" Padding="10">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="📧 邮箱" FontSize="14" FontWeight="SemiBold" Margin="0,5"/>
                                            <TextBlock Text="zjhwyq123456@qq.com" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,15"/>
                                            <TextBlock Text="📱 抖音" FontSize="14" FontWeight="SemiBold" Margin="0,5"/>
                                            <TextBlock Text="耄耋杀毒软件" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,15"/>
                                            <TextBlock Text="❤️ 感谢您的支持！" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PrimaryColor}" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
                
                <Border Background="{DynamicResource BgSecondary}" CornerRadius="8" Padding="20">
                    <StackPanel>
                        <TextBlock Text="联系我们" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10"/>
                        <TextBlock Text="如果您有任何建议或问题，欢迎通过以下方式联系我们：" 
                                   TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,10"/>
                        <TextBlock Text="邮箱: zjhwyq123456@qq.com" Foreground="{DynamicResource TextSecondary}" Margin="0,2"/>
                        <TextBlock Text="抖音: 耄耋软件工作室" Foreground="{DynamicResource TextSecondary}" Margin="0,2"/>
                        <TextBlock Text="感谢您的支持！" FontWeight="Bold" Foreground="{DynamicResource PrimaryColor}" Margin="0,15,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
