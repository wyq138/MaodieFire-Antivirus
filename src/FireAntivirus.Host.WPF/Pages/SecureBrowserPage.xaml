<Page x:Class="FireAntivirus.Host.WPF.Pages.SecureBrowserPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="安全浏览器">
    <Grid x:Name="MainGrid" Background="{DynamicResource BgPrimary}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="20,15">
            <TextBlock x:Name="TitleText" Text="安全浏览器" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
        </Grid>
        <ScrollViewer Grid.Row="1" Margin="20,0,20,20">
            <StackPanel>
                <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,15" Padding="15">
                    <StackPanel>
                        <TextBlock Text="🌐 浏览器安全防护" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10"/>
                        <TextBlock x:Name="StatusText" Text="状态: 已启用" FontSize="12" Foreground="Green"/>
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,15" Padding="15">
                    <StackPanel>
                        <TextBlock Text="🔒 安全浏览" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10"/>
                        <CheckBox x:Name="EnableSafeBrowsing" Content="启用安全浏览" IsChecked="True" Margin="0,5"/>
                        <CheckBox x:Name="BlockMaliciousSites" Content="拦截恶意网站" IsChecked="True" Margin="0,5"/>
                        <CheckBox x:Name="BlockDownloads" Content="拦截危险下载" IsChecked="True" Margin="0,5"/>
                        <CheckBox x:Name="WarnCertificates" Content="证书警告" IsChecked="True" Margin="0,5"/>
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,15" Padding="15">
                    <StackPanel>
                        <TextBlock Text="🏦 网银保护" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10"/>
                        <CheckBox x:Name="EnableBankingProtection" Content="启用网银保护" IsChecked="True" Margin="0,5"/>
                        <TextBlock Text="访问银行网站时自动启用安全模式" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="20,0,0,5"/>
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,15" Padding="15">
                    <StackPanel>
                        <TextBlock Text="📊 今日防护统计" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10"/>
                        <TextBlock x:Name="BlockedCount" Text="已拦截恶意网站: 0 个" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                        <TextBlock x:Name="WarnedCount" Text="安全警告: 0 次" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
