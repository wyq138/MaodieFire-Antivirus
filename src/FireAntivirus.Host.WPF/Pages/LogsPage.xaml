<Page x:Class="FireAntivirus.Host.WPF.Pages.LogsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="日志中心">
    
    <Grid x:Name="MainGrid" Background="{DynamicResource BgPrimary}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- 标题区域 -->
        <Grid Grid.Row="0" Margin="20,15">
            <TextBlock x:Name="TitleText" 
                       Text="日志中心" 
                       FontSize="18" 
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimary}"/>
        </Grid>
        
        <!-- 内容区域 -->
        <Grid Grid.Row="1" Margin="20,0,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- 控制按钮区域 -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                <Button x:Name="ClearLogsBtn"
                        Content="清空日志"
                        Width="100"
                        Height="40"
                        Margin="0,0,10,0"
                        Background="{DynamicResource BgTertiary}"
                        Foreground="{DynamicResource TextPrimary}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        Click="ClearLogs_Click"
                        Cursor="Hand"/>
                
                <Button x:Name="ExportLogsBtn"
                        Content="导出日志"
                        Width="100"
                        Height="40"
                        Margin="10,0,0,0"
                        Background="{DynamicResource BgTertiary}"
                        Foreground="{DynamicResource TextPrimary}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        Click="ExportLogs_Click"
                        Cursor="Hand"/>
            </StackPanel>
            
            <!-- 日志选项卡 -->
            <TabControl x:Name="LogsTabControl"
                        Grid.Row="1"
                        Background="{DynamicResource BgPrimary}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1">
                <TabItem Header="查杀日志">
                    <ListBox x:Name="ScanLogList"
                             Background="{DynamicResource BgTertiary}"
                             BorderThickness="0"
                             FontSize="12"/>
                </TabItem>
                <TabItem Header="防护日志">
                    <ListBox x:Name="ProtectionLogList"
                             Background="{DynamicResource BgTertiary}"
                             BorderThickness="0"
                             FontSize="12"/>
                </TabItem>
                <TabItem Header="网络日志">
                    <ListBox x:Name="NetworkLogList"
                             Background="{DynamicResource BgTertiary}"
                             BorderThickness="0"
                             FontSize="12"/>
                </TabItem>
                <TabItem Header="系统日志">
                    <ListBox x:Name="SystemLogList"
                             Background="{DynamicResource BgTertiary}"
                             BorderThickness="0"
                             FontSize="12"/>
                </TabItem>
                <TabItem Header="更新日志">
                    <ListBox x:Name="UpdateLogList"
                             Background="{DynamicResource BgTertiary}"
                             BorderThickness="0"
                             FontSize="12"/>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Page>
