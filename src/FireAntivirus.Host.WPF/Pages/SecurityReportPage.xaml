<Page x:Class="FireAntivirus.Host.WPF.Pages.SecurityReportPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="安全报告">

    <Grid x:Name="MainGrid" Background="{DynamicResource BgPrimary}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题区域 -->
        <Grid Grid.Row="0" Margin="20,15">
            <TextBlock x:Name="TitleText" 
                       Text="安全报告" 
                       FontSize="18" 
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimary}"/>
        </Grid>

        <!-- 内容区域 -->
        <ScrollViewer Grid.Row="1" Margin="20,0,20,20" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 报告生成选项 -->
                <Border x:Name="GeneratePanel"
                        Background="{DynamicResource CardBg}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="0,0,0,15"
                        Padding="15">
                    <StackPanel>
                        <TextBlock Text="报告生成选项" 
                                   FontSize="14" 
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   Margin="0,0,0,15"/>

                        <!-- 报告类型选择 -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="报告类型:" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" x:Name="ReportTypeCombo" SelectedIndex="0" Height="30">
                                <ComboBoxItem Content="完整安全报告"/>
                                <ComboBoxItem Content="扫描报告"/>
                                <ComboBoxItem Content="威胁分析报告"/>
                                <ComboBoxItem Content="系统健康报告"/>
                            </ComboBox>
                        </Grid>

                        <!-- 时间范围 -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="时间范围:" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" x:Name="TimeRangeCombo" SelectedIndex="0" Height="30">
                                <ComboBoxItem Content="最近24小时"/>
                                <ComboBoxItem Content="最近7天"/>
                                <ComboBoxItem Content="最近30天"/>
                                <ComboBoxItem Content="最近90天"/>
                                <ComboBoxItem Content="全部时间"/>
                            </ComboBox>
                        </Grid>

                        <!-- 包含内容 -->
                        <TextBlock Text="包含内容:" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,5,0,10"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" x:Name="IncludeScanResults" IsChecked="True" Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="1" Text="扫描结果" FontSize="12" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" x:Name="IncludeThreats" IsChecked="True" Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="1" Text="威胁详情" FontSize="12" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" x:Name="IncludeNetwork" IsChecked="True" Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="1" Text="网络活动" FontSize="12" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" x:Name="IncludeSystemInfo" IsChecked="True" Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="1" Text="系统信息" FontSize="12" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" x:Name="IncludeRecommendations" IsChecked="True" Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="1" Text="安全建议" FontSize="12" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- 生成按钮 -->
                        <Button x:Name="GenerateReportBtn"
                                Content="生成报告"
                                Height="40"
                                Margin="0,15,0,0"
                                Background="{DynamicResource PrimaryColor}"
                                Foreground="White"
                                FontSize="14"
                                FontWeight="Bold"
                                Cursor="Hand"
                                Click="GenerateReport_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- 报告模板 -->
                <Border x:Name="TemplatesPanel"
                        Background="{DynamicResource CardBg}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="0,0,0,15"
                        Padding="15">
                    <StackPanel>
                        <TextBlock Text="报告模板" 
                                   FontSize="14" 
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   Margin="0,0,0,15"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 标准模板 -->
                            <Border Grid.Column="0"
                                    Background="{DynamicResource BgTertiary}"
                                    CornerRadius="8"
                                    Padding="15"
                                    Margin="0,0,10,0"
                                    Cursor="Hand"
                                    x:Name="StandardTemplate"
                                    BorderBrush="{DynamicResource PrimaryColor}"
                                    BorderThickness="2">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="标准报告" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="基础安全报告模板" FontSize="10" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- 详细模板 -->
                            <Border Grid.Column="1"
                                    Background="{DynamicResource BgTertiary}"
                                    CornerRadius="8"
                                    Padding="15"
                                    Margin="10,0,10,0"
                                    Cursor="Hand"
                                    x:Name="DetailedTemplate"
                                    BorderBrush="Transparent"
                                    BorderThickness="2">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="详细报告" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="完整安全分析模板" FontSize="10" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- 自定义模板 -->
                            <Border Grid.Column="2"
                                    Background="{DynamicResource BgTertiary}"
                                    CornerRadius="8"
                                    Padding="15"
                                    Margin="10,0,0,0"
                                    Cursor="Hand"
                                    x:Name="CustomTemplate"
                                    BorderBrush="Transparent"
                                    BorderThickness="2">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="自定义" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="自定义报告模板" FontSize="10" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 定时报告设置 -->
                <Border x:Name="ScheduledPanel"
                        Background="{DynamicResource CardBg}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="0,0,0,15"
                        Padding="15">
                    <StackPanel>
                        <TextBlock Text="定时报告" 
                                   FontSize="14" 
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   Margin="0,0,0,15"/>

                        <!-- 启用定时报告 -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="启用定时报告" FontSize="12" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                            <CheckBox Grid.Column="1" x:Name="EnableScheduledCheck" IsChecked="False"/>
                        </Grid>

                        <!-- 报告频率 -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="报告频率:" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" x:Name="FrequencyCombo" SelectedIndex="0" Height="30" IsEnabled="False">
                                <ComboBoxItem Content="每天"/>
                                <ComboBoxItem Content="每周"/>
                                <ComboBoxItem Content="每月"/>
                            </ComboBox>
                        </Grid>

                        <!-- 发送方式 -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="发送方式:" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" x:Name="EmailTextBox" Text="user@example.com" Height="30" IsEnabled="False"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 已生成报告列表 -->
                <Border x:Name="ReportsListPanel"
                        Background="{DynamicResource CardBg}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="0,0,0,15"
                        Padding="15">
                    <StackPanel>
                        <TextBlock Text="已生成报告" 
                                   FontSize="14" 
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   Margin="0,0,0,10"/>

                        <DataGrid x:Name="ReportsGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  Background="{DynamicResource BgTertiary}"
                                  Foreground="{DynamicResource TextPrimary}"
                                  BorderBrush="{DynamicResource BorderColor}"
                                  BorderThickness="1"
                                  GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  MinHeight="150"
                                  MaxHeight="250">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="报告名称" Binding="{Binding ReportName}" Width="*"/>
                                <DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="100"/>
                                <DataGridTextColumn Header="生成时间" Binding="{Binding GeneratedTime}" Width="150"/>
                                <DataGridTextColumn Header="大小" Binding="{Binding Size}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- 导出选项 -->
                <Border x:Name="ExportPanel"
                        Background="{DynamicResource CardBg}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="15">
                    <StackPanel>
                        <TextBlock Text="导出选项" 
                                   FontSize="14" 
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   Margin="0,0,0,15"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="ExportPdfBtn"
                                    Grid.Column="0"
                                    Content="导出 PDF"
                                    Height="38"
                                    Margin="0,0,10,0"
                                    Background="{DynamicResource ErrorColor}"
                                    Foreground="White"
                                    FontSize="13"
                                    Cursor="Hand"
                                    Click="ExportPdf_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button x:Name="ExportHtmlBtn"
                                    Grid.Column="1"
                                    Content="导出 HTML"
                                    Height="38"
                                    Margin="10,0,10,0"
                                    Background="{DynamicResource PrimaryColor}"
                                    Foreground="White"
                                    FontSize="13"
                                    Cursor="Hand"
                                    Click="ExportHtml_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button x:Name="ExportXmlBtn"
                                    Grid.Column="2"
                                    Content="导出 XML"
                                    Height="38"
                                    Margin="10,0,0,0"
                                    Background="{DynamicResource BgTertiary}"
                                    Foreground="{DynamicResource TextPrimary}"
                                    BorderBrush="{DynamicResource BorderColor}"
                                    BorderThickness="1"
                                    FontSize="13"
                                    Cursor="Hand"
                                    Click="ExportXml_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
