<Page x:Class="FireAntivirus.Host.WPF.Pages.EmailSecurityPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="邮件安全">

    <Grid x:Name="MainGrid" Background="{DynamicResource BgPrimary}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- 标题区域 -->
        <Grid Grid.Row="0" Margin="20,15">
            <TextBlock x:Name="TitleText" 
                       Text="邮件安全" 
                       FontSize="18" 
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimary}"/>
        </Grid>
        
        <!-- 内容区域 -->
        <ScrollViewer Grid.Row="1" Margin="20,0,20,20">
            <StackPanel>
                <!-- 防护状态卡片 -->
                <Border Background="{DynamicResource CardBg}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="0,0,0,15"
                        Padding="15">
                    <StackPanel>
                        <TextBlock Text="📧 防护状态" 
                                   FontSize="14" 
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   Margin="0,0,0,10"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" 
                                       Text="当前状态：" 
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimary}"
                                       Margin="0,0,10,0"/>
                            <TextBlock x:Name="StatusText" 
                                       Grid.Column="1"
                                       Text="邮件防护已启用" 
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="Green"/>
                        </Grid>
                        
                        <TextBlock Text="自动扫描收发邮件，检测潜在威胁" 
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
                
                <!-- 安全选项卡片 -->
                <Border Background="{DynamicResource CardBg}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="0,0,0,15"
                        Padding="15">
                    <StackPanel>
                        <TextBlock Text="🔒 安全选项" 
                                   FontSize="14" 
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   Margin="0,0,0,10"/>
                        
                        <CheckBox x:Name="AttachmentScanCheck" 
                                  Content="附件扫描" 
                                  IsChecked="True" 
                                  Margin="0,5"
                                  Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="自动扫描邮件附件中的病毒和恶意软件"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Margin="20,0,0,10"/>
                        
                        <CheckBox x:Name="PhishingDetectionCheck" 
                                  Content="钓鱼邮件检测" 
                                  IsChecked="True" 
                                  Margin="0,5"
                                  Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="识别并拦截钓鱼邮件和欺诈邮件"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Margin="20,0,0,10"/>
                        
                        <CheckBox x:Name="SpamFilterCheck" 
                                  Content="垃圾邮件过滤" 
                                  IsChecked="True" 
                                  Margin="0,5"
                                  Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="过滤垃圾邮件，保持收件箱清洁"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Margin="20,0,0,10"/>
                        
                        <CheckBox x:Name="LinkProtectionCheck" 
                                  Content="链接安全检测" 
                                  IsChecked="True" 
                                  Margin="0,5"
                                  Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="检测邮件中的恶意链接"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Margin="20,0,0,10"/>
                    </StackPanel>
                </Border>
                
                <!-- 已扫描邮件卡片 -->
                <Border Background="{DynamicResource CardBg}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="0,0,0,15"
                        Padding="15">
                    <StackPanel>
                        <TextBlock Text="📋 已扫描邮件" 
                                   FontSize="14" 
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   Margin="0,0,0,10"/>
                        
                        <DataGrid x:Name="ScannedEmailsGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  Height="200"
                                  Background="{DynamicResource BgTertiary}"
                                  Foreground="{DynamicResource TextPrimary}"
                                  BorderBrush="{DynamicResource BorderColor}"
                                  BorderThickness="1"
                                  GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="发件人" Binding="{Binding Sender}" Width="150"/>
                                <DataGridTextColumn Header="主题" Binding="{Binding Subject}" Width="*"/>
                                <DataGridTextColumn Header="扫描时间" Binding="{Binding ScanTime}" Width="120"/>
                                <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
                
                <!-- 保存按钮 -->
                <Button x:Name="SaveSettingsBtn" 
                        Content="保存设置" 
                        Width="120" 
                        Height="35"
                        Background="{DynamicResource PrimaryColor}"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        HorizontalAlignment="Left"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
