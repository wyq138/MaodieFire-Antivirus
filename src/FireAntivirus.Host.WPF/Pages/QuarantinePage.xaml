<Page x:Class="FireAntivirus.Host.WPF.Pages.QuarantinePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="隔离区">
    
    <Grid x:Name="MainGrid" Background="{DynamicResource BgPrimary}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- 标题区域 -->
        <Grid Grid.Row="0" Margin="20,15">
            <TextBlock x:Name="TitleText" 
                       Text="隔离区" 
                       FontSize="18" 
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimary}"/>
        </Grid>
        
        <!-- 内容区域 -->
        <Grid Grid.Row="1" Margin="20,0,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- 控制按钮区域 -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                <Button x:Name="RestoreBtn"
                        Content="恢复文件"
                        Width="100"
                        Height="40"
                        Margin="0,0,10,0"
                        Background="{DynamicResource BgTertiary}"
                        Foreground="{DynamicResource TextPrimary}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        Click="RestoreSelectedFiles_Click"
                        Cursor="Hand"/>
                
                <Button x:Name="DeleteBtn"
                        Content="删除文件"
                        Width="100"
                        Height="40"
                        Margin="10,0,10,0"
                        Background="{DynamicResource BgTertiary}"
                        Foreground="{DynamicResource TextPrimary}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        Click="DeleteSelectedFiles_Click"
                        Cursor="Hand"/>
                
                <Button x:Name="ClearBtn"
                        Content="清空隔离区"
                        Width="100"
                        Height="40"
                        Margin="10,0,10,0"
                        Background="{DynamicResource BgTertiary}"
                        Foreground="{DynamicResource TextPrimary}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        Click="ClearQuarantine_Click"
                        Cursor="Hand"/>
                
                <Button x:Name="RefreshBtn"
                        Content="刷新"
                        Width="100"
                        Height="40"
                        Margin="10,0,0,0"
                        Background="{DynamicResource BgTertiary}"
                        Foreground="{DynamicResource TextPrimary}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        Click="LoadQuarantineFiles_Click"
                        Cursor="Hand"/>
            </StackPanel>
            
            <!-- 文件列表 -->
            <DataGrid x:Name="QuarantineGrid"
                      Grid.Row="1"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      Background="{DynamicResource BgTertiary}"
                      Foreground="{DynamicResource TextPrimary}"
                      BorderBrush="{DynamicResource BorderColor}"
                      BorderThickness="1"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="False"
                      VirtualizingPanel.VirtualizationMode="Recycling">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="文件名" Binding="{Binding FileName}" Width="200"/>
                    <DataGridTextColumn Header="原始路径" Binding="{Binding OriginalPath}" Width="*"/>
                    <DataGridTextColumn Header="威胁类型" Binding="{Binding ThreatType}" Width="150"/>
                    <DataGridTextColumn Header="隔离时间" Binding="{Binding QuarantineTime}" Width="150"/>
                    <DataGridTextColumn Header="大小" Binding="{Binding Size}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</Page>
