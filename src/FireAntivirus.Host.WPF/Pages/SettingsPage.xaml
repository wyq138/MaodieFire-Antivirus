<Page x:Class="FireAntivirus.Host.WPF.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="设置">
    
    <Grid x:Name="MainGrid" Background="{DynamicResource BgPrimary}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- 标题区域 -->
        <Grid Grid.Row="0" Margin="20,15">
            <TextBlock x:Name="TitleText" 
                       Text="设置" 
                       FontSize="18" 
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimary}"/>
        </Grid>
        
        <!-- 设置选项卡 -->
        <TabControl Grid.Row="1" 
                    x:Name="SettingsTabControl"
                    Margin="20,0,20,20"
                    Background="{DynamicResource BgPrimary}"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1">
            
            <!-- 外观设置 -->
            <TabItem x:Name="AppearanceTab" Header="外观设置">
                <ScrollViewer Background="{DynamicResource BgTertiary}" Padding="20">
                    <StackPanel>
                        <TextBlock x:Name="AppearanceTitle" 
                                   Text="外观设置" 
                                   FontSize="14" 
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   Margin="0,0,0,20"/>
                        
                        <!-- 主题选择 -->
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ThemeLabel"
                                       Grid.Column="0" 
                                       Text="主题" 
                                       FontSize="12"
                                       Foreground="{DynamicResource TextPrimary}"
                                       VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="LightThemeBtn"
                                        Content="浅色"
                                        Width="80"
                                        Height="35"
                                        Margin="0,0,10,0"
                                        Background="{DynamicResource BgTertiary}"
                                        Foreground="{DynamicResource TextPrimary}"
                                        BorderBrush="{DynamicResource BorderColor}"
                                        BorderThickness="1"
                                        Click="LightTheme_Click"
                                        Cursor="Hand"/>
                                <Button x:Name="DarkThemeBtn"
                                        Content="深色"
                                        Width="80"
                                        Height="35"
                                        Background="{DynamicResource BgTertiary}"
                                        Foreground="{DynamicResource TextPrimary}"
                                        BorderBrush="{DynamicResource BorderColor}"
                                        BorderThickness="1"
                                        Click="DarkTheme_Click"
                                        Cursor="Hand"/>
                            </StackPanel>
                        </Grid>
                        
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            
            <!-- 扫描设置 -->
            <TabItem x:Name="ScanSettingsTab" Header="扫描设置">
                <ScrollViewer Background="{DynamicResource BgTertiary}" Padding="20">
                    <StackPanel>
                        <TextBlock x:Name="ScanSettingsTitle" 
                                   Text="扫描设置" 
                                   FontSize="14" 
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   Margin="0,0,0,20"/>
                        
                        <!-- 扫描线程 -->
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ScanThreadsLabel"
                                       Grid.Column="0" 
                                       Text="扫描线程数" 
                                       FontSize="12"
                                       Foreground="{DynamicResource TextPrimary}"
                                       VerticalAlignment="Center"/>
                            <ComboBox x:Name="ThreadsComboBox"
                                      Grid.Column="1"
                                      Width="80"
                                      Height="30"
                                      SelectedIndex="3">
                                <ComboBoxItem Content="1"/>
                                <ComboBoxItem Content="2"/>
                                <ComboBoxItem Content="3"/>
                                <ComboBoxItem Content="4"/>
                                <ComboBoxItem Content="8"/>
                                <ComboBoxItem Content="16"/>
                            </ComboBox>
                        </Grid>
                        
                        <!-- 扫描文件类型 -->
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ScanFileTypesLabel"
                                       Grid.Column="0" 
                                       Text="扫描所有文件类型" 
                                       FontSize="12"
                                       Foreground="{DynamicResource TextPrimary}"
                                       VerticalAlignment="Center"/>
                            <CheckBox x:Name="AllFileTypesCheckBox"
                                      Grid.Column="1"
                                      IsChecked="True"
                                      VerticalAlignment="Center"/>
                        </Grid>
                        
                        <!-- 快速扫描 -->
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="QuickScanLabel"
                                       Grid.Column="0" 
                                       Text="启用快速扫描" 
                                       FontSize="12"
                                       Foreground="{DynamicResource TextPrimary}"
                                       VerticalAlignment="Center"/>
                            <CheckBox x:Name="QuickScanCheckBox"
                                      Grid.Column="1"
                                      IsChecked="True"
                                      VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            
            <!-- 防护设置 -->
            <TabItem x:Name="ProtectionSettingsTab" Header="防护设置">
                <ScrollViewer Background="{DynamicResource BgTertiary}" Padding="20">
                    <StackPanel>
                        <TextBlock x:Name="ProtectionSettingsTitle" 
                                   Text="防护设置" 
                                   FontSize="14" 
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   Margin="0,0,0,20"/>
                        
                        <!-- 开机启动保护 -->
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="StartupProtectionLabel"
                                       Grid.Column="0" 
                                       Text="开机启动保护" 
                                       FontSize="12"
                                       Foreground="{DynamicResource TextPrimary}"
                                       VerticalAlignment="Center"/>
                            <CheckBox x:Name="StartupProtectionCheckBox"
                                      Grid.Column="1"
                                      IsChecked="True"
                                      VerticalAlignment="Center"/>
                        </Grid>
                        
                        <!-- 防护提醒 -->
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ProtectionAlertsLabel"
                                       Grid.Column="0" 
                                       Text="弹出防护提醒" 
                                       FontSize="12"
                                       Foreground="{DynamicResource TextPrimary}"
                                       VerticalAlignment="Center"/>
                            <CheckBox x:Name="AlertCheckBox"
                                      Grid.Column="1"
                                      IsChecked="True"
                                      VerticalAlignment="Center"/>
                        </Grid>
                        
                        <!-- 实时防护 -->
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="RealTimeProtectionLabel"
                                       Grid.Column="0" 
                                       Text="实时防护" 
                                       FontSize="12"
                                       Foreground="{DynamicResource TextPrimary}"
                                       VerticalAlignment="Center"/>
                            <CheckBox x:Name="RealTimeProtectionCheckBox"
                                      Grid.Column="1"
                                      IsChecked="True"
                                      VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            
            <!-- 网络设置 -->
            <TabItem x:Name="NetworkSettingsTab" Header="网络设置">
                <ScrollViewer Background="{DynamicResource BgTertiary}" Padding="20">
                    <StackPanel>
                        <TextBlock x:Name="NetworkSettingsTitle" 
                                   Text="网络设置" 
                                   FontSize="14" 
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   Margin="0,0,0,20"/>
                        
                        <!-- 防火墙 -->
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="FirewallLabel"
                                       Grid.Column="0" 
                                       Text="防火墙" 
                                       FontSize="12"
                                       Foreground="{DynamicResource TextPrimary}"
                                       VerticalAlignment="Center"/>
                            <CheckBox x:Name="FirewallCheckBox"
                                      Grid.Column="1"
                                      IsChecked="True"
                                      VerticalAlignment="Center"/>
                        </Grid>
                        
                        <!-- 网络监控 -->
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="NetworkMonitorLabel"
                                       Grid.Column="0" 
                                       Text="网络监控" 
                                       FontSize="12"
                                       Foreground="{DynamicResource TextPrimary}"
                                       VerticalAlignment="Center"/>
                            <CheckBox x:Name="NetworkMonitorCheckBox"
                                      Grid.Column="1"
                                      IsChecked="True"
                                      VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            
            <!-- 系统设置 -->
            <TabItem x:Name="SystemSettingsTab" Header="系统设置">
                <ScrollViewer Background="{DynamicResource BgTertiary}" Padding="20">
                    <StackPanel>
                        <TextBlock x:Name="SystemSettingsTitle" 
                                   Text="系统设置" 
                                   FontSize="14" 
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   Margin="0,0,0,20"/>
                        
                        <!-- 开机自启动 -->
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="AutoStartLabel"
                                       Grid.Column="0" 
                                       Text="开机自启动" 
                                       FontSize="12"
                                       Foreground="{DynamicResource TextPrimary}"
                                       VerticalAlignment="Center"/>
                            <CheckBox x:Name="AutoStartCheckBox"
                                      Grid.Column="1"
                                      IsChecked="True"
                                      VerticalAlignment="Center"/>
                        </Grid>
                        
                        <!-- 最小化到托盘 -->
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="MinimizeToTrayLabel"
                                       Grid.Column="0" 
                                       Text="最小化到托盘" 
                                       FontSize="12"
                                       Foreground="{DynamicResource TextPrimary}"
                                       VerticalAlignment="Center"/>
                            <CheckBox x:Name="MinimizeToTrayCheckBox"
                                      Grid.Column="1"
                                      IsChecked="True"
                                      VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            
            <!-- 更新设置 -->
            <TabItem x:Name="UpdateSettingsTab" Header="更新设置">
                <ScrollViewer Background="{DynamicResource BgTertiary}" Padding="20">
                    <StackPanel>
                        <TextBlock x:Name="UpdateSettingsTitle" 
                                   Text="更新设置" 
                                   FontSize="14" 
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   Margin="0,0,0,20"/>
                        
                        <!-- 自动更新 -->
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="AutoUpdateLabel"
                                       Grid.Column="0" 
                                       Text="自动检查更新" 
                                       FontSize="12"
                                       Foreground="{DynamicResource TextPrimary}"
                                       VerticalAlignment="Center"/>
                            <CheckBox x:Name="AutoUpdateCheckBox"
                                      Grid.Column="1"
                                      IsChecked="True"
                                      VerticalAlignment="Center"/>
                        </Grid>
                        
                        <!-- 检查更新按钮 -->
                        <Button x:Name="CheckUpdateBtn"
                                Content="检查更新"
                                Width="120"
                                Height="40"
                                Margin="0,20,0,0"
                                Background="{DynamicResource PrimaryColor}"
                                Foreground="White"
                                BorderThickness="0"
                                Click="CheckUpdate_Click"
                                Cursor="Hand"
                                HorizontalAlignment="Left"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
