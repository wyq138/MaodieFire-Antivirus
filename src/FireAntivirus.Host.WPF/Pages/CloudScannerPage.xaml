<Page x:Class="FireAntivirus.Host.WPF.Pages.CloudScannerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="云查杀">

    <Grid x:Name="MainGrid" Background="{DynamicResource BgPrimary}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- 标题区域 -->
        <Grid Grid.Row="0" Margin="20,15">
            <TextBlock x:Name="TitleText" 
                       Text="云查杀" 
                       FontSize="18" 
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimary}"/>
        </Grid>
        
        <!-- 内容区域 -->
        <ScrollViewer Grid.Row="1" Margin="20,0,20,20">
            <StackPanel>
                <!-- 云查杀状态 -->
                <Border Background="{DynamicResource CardBg}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="0,0,0,15"
                        Padding="15">
                    <StackPanel>
                        <TextBlock Text="☁️ 云端病毒检测" 
                                   FontSize="14" 
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   Margin="0,0,0,10"/>
                        <TextBlock x:Name="StatusText" 
                                   Text="连接状态: 已连接云端服务" 
                                   FontSize="12"
                                   Foreground="Green"
                                   Margin="0,0,0,5"/>
                        <TextBlock Text="使用云端病毒库进行深度扫描，检测未知威胁" 
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>
                </Border>
                
                <!-- 扫描选项 -->
                <Border Background="{DynamicResource CardBg}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="0,0,0,15"
                        Padding="15">
                    <StackPanel>
                        <TextBlock Text="🔍 扫描选项" 
                                   FontSize="14" 
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   Margin="0,0,0,10"/>
                        
                        <RadioButton x:Name="QuickScanRadio" Content="快速扫描 (检查关键区域)" IsChecked="True" Margin="0,5"/>
                        <RadioButton x:Name="FullScanRadio" Content="全面扫描 (检查所有文件)" Margin="0,5"/>
                        <RadioButton x:Name="CustomScanRadio" Content="自定义扫描" Margin="0,5"/>
                        
                        <Button x:Name="SelectFileBtn" 
                                Content="选择文件/文件夹" 
                                Width="120" 
                                Height="28"
                                Margin="0,10,0,0"
                                Click="SelectFile_Click"
                                IsEnabled="{Binding IsChecked, ElementName=CustomScanRadio}"/>
                    </StackPanel>
                </Border>
                
                <!-- 扫描进度 -->
                <Border x:Name="ProgressPanel"
                        Background="{DynamicResource CardBg}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="0,0,0,15"
                        Padding="15"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="扫描进度" 
                                   FontSize="14" 
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   Margin="0,0,0,10"/>
                        
                        <ProgressBar x:Name="ScanProgress" Height="20" Margin="0,0,0,10"/>
                        <TextBlock x:Name="ProgressText" Text="准备扫描..." FontSize="12"/>
                    </StackPanel>
                </Border>
                
                <!-- 操作按钮 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="StartScanBtn" 
                            Content="开始云查杀" 
                            Width="110" 
                            Height="35"
                            Background="{DynamicResource PrimaryColor}"
                            Foreground="White"
                            BorderThickness="0"
                            Click="StartScan_Click"
                            Margin="0,0,10,0"/>
                    <Button x:Name="StopScanBtn" 
                            Content="停止" 
                            Width="80" 
                            Height="35"
                            Background="{DynamicResource ErrorColor}"
                            Foreground="White"
                            BorderThickness="0"
                            IsEnabled="False"
                            Click="StopScan_Click"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
