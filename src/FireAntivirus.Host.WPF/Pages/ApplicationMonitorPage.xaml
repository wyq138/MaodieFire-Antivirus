<Page x:Class="FireAntivirus.Host.WPF.Pages.ApplicationMonitorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="应用监控">

    <Grid x:Name="MainGrid" Background="{DynamicResource BgPrimary}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题区域 -->
        <Grid Grid.Row="0" Margin="20,15">
            <TextBlock x:Name="TitleText" 
                       Text="应用监控" 
                       FontSize="18" 
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimary}"/>
        </Grid>

        <!-- 内容区域 -->
        <Grid Grid.Row="1" Margin="20,0,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 资源概览 -->
            <Border Grid.Row="0"
                    Background="{DynamicResource CardBg}"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Margin="0,0,0,15"
                    Padding="15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- CPU -->
                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                        <TextBlock Text="CPU" FontSize="12" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="CpuUsageText" Text="32%" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PrimaryColor}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                        <ProgressBar x:Name="CpuProgressBar" Width="80" Height="6" Value="32" Maximum="100" Foreground="{DynamicResource PrimaryColor}" Background="{DynamicResource BgTertiary}" Margin="0,5,0,0"/>
                    </StackPanel>

                    <!-- 内存 -->
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                        <TextBlock Text="内存" FontSize="12" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="MemoryUsageText" Text="58%" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource SuccessColor}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                        <ProgressBar x:Name="MemoryProgressBar" Width="80" Height="6" Value="58" Maximum="100" Foreground="{DynamicResource SuccessColor}" Background="{DynamicResource BgTertiary}" Margin="0,5,0,0"/>
                    </StackPanel>

                    <!-- 磁盘 -->
                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                        <TextBlock Text="磁盘" FontSize="12" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="DiskUsageText" Text="45%" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource WarningColor}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                        <ProgressBar x:Name="DiskProgressBar" Width="80" Height="6" Value="45" Maximum="100" Foreground="{DynamicResource WarningColor}" Background="{DynamicResource BgTertiary}" Margin="0,5,0,0"/>
                    </StackPanel>

                    <!-- 网络 -->
                    <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                        <TextBlock Text="网络" FontSize="12" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="NetworkUsageText" Text="12%" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource InfoColor}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                        <ProgressBar x:Name="NetworkProgressBar" Width="80" Height="6" Value="12" Maximum="100" Foreground="{DynamicResource InfoColor}" Background="{DynamicResource BgTertiary}" Margin="0,5,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 可疑活动告警 -->
            <Border Grid.Row="1"
                    x:Name="AlertPanel"
                    Background="#FFF3E0"
                    BorderBrush="#FF9800"
                    BorderThickness="1"
                    CornerRadius="8"
                    Margin="0,0,0,15"
                    Padding="15"
                    Visibility="Visible">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="!" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource WarningColor}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" x:Name="AlertText" Text="发现 2 个可疑进程活动" FontSize="12" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" Content="查看详情" Width="80" Height="28" Background="{DynamicResource WarningColor}" Foreground="White" FontSize="11" Cursor="Hand"/>
                </Grid>
            </Border>

            <!-- 进程列表 -->
            <Border Grid.Row="2"
                    Background="{DynamicResource CardBg}"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 标题和控制 -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="运行进程" 
                                   FontSize="14" 
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="RefreshProcessBtn"
                                    Content="刷新"
                                    Width="70"
                                    Height="28"
                                    Margin="0,0,8,0"
                                    Background="{DynamicResource BgTertiary}"
                                    Foreground="{DynamicResource TextPrimary}"
                                    BorderBrush="{DynamicResource BorderColor}"
                                    BorderThickness="1"
                                    Cursor="Hand"
                                    Click="RefreshProcess_Click"/>
                            <Button x:Name="EndProcessBtn"
                                    Content="结束进程"
                                    Width="80"
                                    Height="28"
                                    Background="{DynamicResource ErrorColor}"
                                    Foreground="White"
                                    Cursor="Hand"
                                    Click="EndProcess_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="3">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- 进程DataGrid -->
                    <DataGrid x:Name="ProcessGrid"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              Background="{DynamicResource BgTertiary}"
                              Foreground="{DynamicResource TextPrimary}"
                              BorderBrush="{DynamicResource BorderColor}"
                              BorderThickness="1"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="False"
                              VirtualizingPanel.VirtualizationMode="Recycling">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="进程名" Binding="{Binding ProcessName}" Width="180"/>
                            <DataGridTextColumn Header="PID" Binding="{Binding PID}" Width="80"/>
                            <DataGridTextColumn Header="CPU" Binding="{Binding CPU}" Width="80"/>
                            <DataGridTextColumn Header="内存" Binding="{Binding Memory}" Width="100"/>
                            <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="100"/>
                            <DataGridTextColumn Header="路径" Binding="{Binding Path}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- 进程详情面板 -->
            <Border Grid.Row="3"
                    x:Name="ProcessDetailPanel"
                    Background="{DynamicResource CardBg}"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Margin="0,15,0,0"
                    Padding="15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="进程详情" 
                                   FontSize="14" 
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   Margin="0,0,0,10"/>
                        <TextBlock x:Name="DetailProcessName" Text="进程名: --" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,5"/>
                        <TextBlock x:Name="DetailProcessPath" Text="路径: --" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,5"/>
                        <TextBlock x:Name="DetailProcessUser" Text="用户: --" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text=" " 
                                   FontSize="14" 
                                   Margin="0,0,0,10"/>
                        <TextBlock x:Name="DetailProcessThreads" Text="线程数: --" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,5"/>
                        <TextBlock x:Name="DetailProcessHandles" Text="句柄数: --" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,5"/>
                        <TextBlock x:Name="DetailProcessStartTime" Text="启动时间: --" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
