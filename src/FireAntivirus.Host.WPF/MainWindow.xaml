<Window x:Class="FireAntivirus.Host.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="耄耋安全软件" Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgPrimary}"
        ResizeMode="CanResize"
        Icon="pack://application:,,,/Resources/cat_icon.ico"
        Loaded="MainWindow_Loaded" Closing="MainWindow_Closing">
    
    <Window.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="BgPrimary" Color="#F5F5F5"/>
            <SolidColorBrush x:Key="BgSecondary" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="BgTertiary" Color="#E8E8E8"/>
            <SolidColorBrush x:Key="TextPrimary" Color="#333333"/>
            <SolidColorBrush x:Key="TextSecondary" Color="#666666"/>
            <SolidColorBrush x:Key="BorderColor" Color="#DDDDDD"/>
            <SolidColorBrush x:Key="PrimaryColor" Color="#4A90D9"/>
            <SolidColorBrush x:Key="AccentColor" Color="#2E7D32"/>
            
            <Style x:Key="NavButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Padding" Value="15,8"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource BgTertiary}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            
            <Style x:Key="NavGroupStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                <Setter Property="Margin" Value="15,15,0,5"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    
    <Grid x:Name="MainGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <Grid x:Name="SidebarGrid" Grid.Column="0" Background="{DynamicResource BgSecondary}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <StackPanel Grid.Row="0" Margin="20,20,20,10">
                <TextBlock x:Name="AppTitleText" Text="耄耋安全软件" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PrimaryColor}"/>
                <TextBlock x:Name="AppSubtitleText" Text="v1.0.0 正式版" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
            </StackPanel>
            
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="NavigationPanel">
                    <TextBlock x:Name="NavGroupMain" Style="{StaticResource NavGroupStyle}" Text="主要"/>
                    <Button x:Name="NavHome" Style="{StaticResource NavButtonStyle}" Click="NavButton_Click" Tag="home">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="🏠" Width="20"/><TextBlock Text="首页" Margin="10,0,0,0"/></StackPanel>
                    </Button>
                    <Button x:Name="NavScan" Style="{StaticResource NavButtonStyle}" Click="NavButton_Click" Tag="scan">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="🔍" Width="20"/><TextBlock Text="病毒扫描" Margin="10,0,0,0"/></StackPanel>
                    </Button>
                    
                    <TextBlock x:Name="NavGroupProtection" Style="{StaticResource NavGroupStyle}" Text="防护"/>
                    <Button x:Name="NavRealTime" Style="{StaticResource NavButtonStyle}" Click="NavButton_Click" Tag="protection">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="🛡️" Width="20"/><TextBlock Text="实时防护" Margin="10,0,0,0"/></StackPanel>
                    </Button>
                    <Button x:Name="NavNetwork" Style="{StaticResource NavButtonStyle}" Click="NavButton_Click" Tag="network">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="🌐" Width="20"/><TextBlock Text="网络防护" Margin="10,0,0,0"/></StackPanel>
                    </Button>
                    <Button x:Name="NavPopup" Style="{StaticResource NavButtonStyle}" Click="NavButton_Click" Tag="popup">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="🚫" Width="20"/><TextBlock Text="弹窗拦截" Margin="10,0,0,0"/></StackPanel>
                    </Button>
                    <Button x:Name="NavRansomware" Style="{StaticResource NavButtonStyle}" Click="NavButton_Click" Tag="ransomware">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="🔒" Width="20"/><TextBlock Text="勒索防护" Margin="10,0,0,0"/></StackPanel>
                    </Button>
                    
                    <TextBlock x:Name="NavGroupSecurity" Style="{StaticResource NavGroupStyle}" Text="安全"/>
                    <Button x:Name="NavPrivacy" Style="{StaticResource NavButtonStyle}" Click="NavButton_Click" Tag="privacy">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="👁️" Width="20"/><TextBlock Text="隐私保护" Margin="10,0,0,0"/></StackPanel>
                    </Button>
                    <Button x:Name="NavParental" Style="{StaticResource NavButtonStyle}" Click="NavButton_Click" Tag="parental">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="👨‍👩‍👧" Width="20"/><TextBlock Text="家长控制" Margin="10,0,0,0"/></StackPanel>
                    </Button>
                    <Button x:Name="NavWeb" Style="{StaticResource NavButtonStyle}" Click="NavButton_Click" Tag="web">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="🌍" Width="20"/><TextBlock Text="网页防护" Margin="10,0,0,0"/></StackPanel>
                    </Button>
                    <Button x:Name="NavEmail" Style="{StaticResource NavButtonStyle}" Click="NavButton_Click" Tag="email">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="📧" Width="20"/><TextBlock Text="邮件安全" Margin="10,0,0,0"/></StackPanel>
                    </Button>
                    <Button x:Name="NavPassword" Style="{StaticResource NavButtonStyle}" Click="NavButton_Click" Tag="password">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="🔑" Width="20"/><TextBlock Text="密码管理" Margin="10,0,0,0"/></StackPanel>
                    </Button>
                    <Button x:Name="NavFirewall" Style="{StaticResource NavButtonStyle}" Click="NavButton_Click" Tag="firewall">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="🔥" Width="20"/><TextBlock Text="防火墙" Margin="10,0,0,0"/></StackPanel>
                    </Button>
                    <Button x:Name="NavDevice" Style="{StaticResource NavButtonStyle}" Click="NavButton_Click" Tag="device">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="💾" Width="20"/><TextBlock Text="设备控制" Margin="10,0,0,0"/></StackPanel>
                    </Button>
                    <Button x:Name="NavVulnerability" Style="{StaticResource NavButtonStyle}" Click="NavButton_Click" Tag="vulnerability">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="⚠️" Width="20"/><TextBlock Text="漏洞扫描" Margin="10,0,0,0"/></StackPanel>
                    </Button>
                    <Button x:Name="NavCloud" Style="{StaticResource NavButtonStyle}" Click="NavButton_Click" Tag="cloud">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="☁️" Width="20"/><TextBlock Text="云扫描" Margin="10,0,0,0"/></StackPanel>
                    </Button>
                    <Button x:Name="NavBrowser" Style="{StaticResource NavButtonStyle}" Click="NavButton_Click" Tag="browser">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="🧭" Width="20"/><TextBlock Text="安全浏览器" Margin="10,0,0,0"/></StackPanel>
                    </Button>
                    <Button x:Name="NavMobile" Style="{StaticResource NavButtonStyle}" Click="NavButton_Click" Tag="mobile">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="📱" Width="20"/><TextBlock Text="移动安全" Margin="10,0,0,0"/></StackPanel>
                    </Button>
                    
                    <TextBlock x:Name="NavGroupTools" Style="{StaticResource NavGroupStyle}" Text="工具"/>
                    <Button x:Name="NavOptimizer" Style="{StaticResource NavButtonStyle}" Click="NavButton_Click" Tag="optimizer">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="⚡" Width="20"/><TextBlock Text="系统优化" Margin="10,0,0,0"/></StackPanel>
                    </Button>
                    <Button x:Name="NavBackup" Style="{StaticResource NavButtonStyle}" Click="NavButton_Click" Tag="backup">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="📦" Width="20"/><TextBlock Text="备份恢复" Margin="10,0,0,0"/></StackPanel>
                    </Button>
                    <Button x:Name="NavScore" Style="{StaticResource NavButtonStyle}" Click="NavButton_Click" Tag="score">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="📊" Width="20"/><TextBlock Text="安全评分" Margin="10,0,0,0"/></StackPanel>
                    </Button>
                    <Button x:Name="NavTraffic" Style="{StaticResource NavButtonStyle}" Click="NavButton_Click" Tag="traffic">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="📈" Width="20"/><TextBlock Text="流量分析" Margin="10,0,0,0"/></StackPanel>
                    </Button>
                    <Button x:Name="NavApp" Style="{StaticResource NavButtonStyle}" Click="NavButton_Click" Tag="app">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="📱" Width="20"/><TextBlock Text="应用监控" Margin="10,0,0,0"/></StackPanel>
                    </Button>
                    <Button x:Name="NavStartup" Style="{StaticResource NavButtonStyle}" Click="NavButton_Click" Tag="startup">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="🚀" Width="20"/><TextBlock Text="启动项管理" Margin="10,0,0,0"/></StackPanel>
                    </Button>
                    <Button x:Name="NavReport" Style="{StaticResource NavButtonStyle}" Click="NavButton_Click" Tag="report">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="📋" Width="20"/><TextBlock Text="安全报告" Margin="10,0,0,0"/></StackPanel>
                    </Button>
                    <Button x:Name="NavBehavior" Style="{StaticResource NavButtonStyle}" Click="NavButton_Click" Tag="behavior">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="🔬" Width="20"/><TextBlock Text="行为分析" Margin="10,0,0,0"/></StackPanel>
                    </Button>
                    <Button x:Name="NavTools" Style="{StaticResource NavButtonStyle}" Click="NavButton_Click" Tag="tools">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="🔧" Width="20"/><TextBlock Text="工具箱" Margin="10,0,0,0"/></StackPanel>
                    </Button>
                    <Button x:Name="NavSystemInfo" Style="{StaticResource NavButtonStyle}" Click="NavButton_Click" Tag="systeminfo">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="💻" Width="20"/><TextBlock Text="系统信息" Margin="10,0,0,0"/></StackPanel>
                    </Button>
                    
                    <TextBlock x:Name="NavGroupSettings" Style="{StaticResource NavGroupStyle}" Text="设置"/>
                    <Button x:Name="NavDonation" Style="{StaticResource NavButtonStyle}" Click="NavButton_Click" Tag="donation">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="❤️" Width="20"/><TextBlock Text="捐赠支持" Margin="10,0,0,0"/></StackPanel>
                    </Button>
                    <Button x:Name="NavQuarantine" Style="{StaticResource NavButtonStyle}" Click="NavButton_Click" Tag="quarantine">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="🗑️" Width="20"/><TextBlock Text="隔离区" Margin="10,0,0,0"/></StackPanel>
                    </Button>
                    <Button x:Name="NavTrust" Style="{StaticResource NavButtonStyle}" Click="NavButton_Click" Tag="trust">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="✅" Width="20"/><TextBlock Text="信任区" Margin="10,0,0,0"/></StackPanel>
                    </Button>
                    <Button x:Name="NavLogs" Style="{StaticResource NavButtonStyle}" Click="NavButton_Click" Tag="logs">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="📜" Width="20"/><TextBlock Text="日志" Margin="10,0,0,0"/></StackPanel>
                    </Button>
                    <Button x:Name="NavSettings" Style="{StaticResource NavButtonStyle}" Click="NavButton_Click" Tag="settings">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="⚙️" Width="20"/><TextBlock Text="设置" Margin="10,0,0,0"/></StackPanel>
                    </Button>
                    <Button x:Name="NavAbout" Style="{StaticResource NavButtonStyle}" Click="NavButton_Click" Tag="about">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="ℹ️" Width="20"/><TextBlock Text="关于" Margin="10,0,0,0"/></StackPanel>
                    </Button>
                </StackPanel>
            </ScrollViewer>
            
            <StackPanel Grid.Row="2" Margin="15" Orientation="Horizontal">
                <TextBlock x:Name="ProtectionStatusDot" Text="●" FontSize="12" Foreground="Green" VerticalAlignment="Center"/>
                <TextBlock x:Name="ProtectionStatusText" Text="防护已开启" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
        
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <Grid Grid.Row="0" Margin="20,15,20,10">
                <TextBlock x:Name="PageTitle" Text="首页" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="ThemeToggleBtn" Content="🌙" Width="36" Height="36" Background="{DynamicResource BgTertiary}" BorderThickness="0" Click="ThemeToggleBtn_Click" Cursor="Hand" FontSize="16"/>
                </StackPanel>
            </Grid>
            
            <Frame x:Name="ContentFrame" Grid.Row="1" NavigationUIVisibility="Hidden" Margin="20,0,20,20"/>
        </Grid>
    </Grid>
</Window>
