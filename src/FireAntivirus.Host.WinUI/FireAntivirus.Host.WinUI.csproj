<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>FireAntivirus.Host.WinUI</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <DefaultLanguage>zh-CN</DefaultLanguage>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <WindowsSdkPackageVersion>10.0.19041.38</WindowsSdkPackageVersion>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- exe 文件图标：小猫图（由 resized-20260723 原图生成的多尺寸 ICO） -->
    <ApplicationIcon>Assets\app_cat.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250228001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
  </ItemGroup>

  <!-- 直接复用现有引擎与公共层：与WPF主机同源，保证检测能力一致 -->
  <ItemGroup>
    <ProjectReference Include="..\FireAntivirus.Engine\FireAntivirus.Engine.csproj" />
    <ProjectReference Include="..\FireAntivirus.Common\FireAntivirus.Common.csproj" />
    <ProjectReference Include="..\FireAntivirus.Data\FireAntivirus.Data.csproj" />
    <ProjectReference Include="..\FireAntivirus.Services\FireAntivirus.Services.csproj" />
    <ProjectReference Include="..\FireAntivirus.ClamAV\FireAntivirus.ClamAV.csproj" />
    <!-- 引用后台防护项目 -->
    <ProjectReference Include="..\FireAntivirus.ServiceHost\FireAntivirus.ServiceHost.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <OutputItemType>Content</OutputItemType>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </ProjectReference>
    <!-- 所有周边安全模块 -->
    <ProjectReference Include="..\FireAntivirus.ApplicationMonitor\FireAntivirus.ApplicationMonitor.csproj" />
    <ProjectReference Include="..\FireAntivirus.Backup\FireAntivirus.Backup.csproj" />
    <ProjectReference Include="..\FireAntivirus.BehaviorAnalysis\FireAntivirus.BehaviorAnalysis.csproj" />
    <ProjectReference Include="..\FireAntivirus.CloudScanner\FireAntivirus.CloudScanner.csproj" />
    <ProjectReference Include="..\FireAntivirus.DeviceControl\FireAntivirus.DeviceControl.csproj" />
    <ProjectReference Include="..\FireAntivirus.EmailSecurity\FireAntivirus.EmailSecurity.csproj" />
    <ProjectReference Include="..\FireAntivirus.Encryption\FireAntivirus.Encryption.csproj" />
    <ProjectReference Include="..\FireAntivirus.MachineLearning\FireAntivirus.MachineLearning.csproj" />
    <ProjectReference Include="..\FireAntivirus.MalwareRemoval\FireAntivirus.MalwareRemoval.csproj" />

    <ProjectReference Include="..\FireAntivirus.NetworkFirewall\FireAntivirus.NetworkFirewall.csproj" />
    <ProjectReference Include="..\FireAntivirus.NetworkSecurity\FireAntivirus.NetworkSecurity.csproj" />
    <ProjectReference Include="..\FireAntivirus.NetworkTrafficAnalyzer\FireAntivirus.NetworkTrafficAnalyzer.csproj" />
    <ProjectReference Include="..\FireAntivirus.ParentalControl\FireAntivirus.ParentalControl.csproj" />
    <ProjectReference Include="..\FireAntivirus.PasswordManager\FireAntivirus.PasswordManager.csproj" />
    <ProjectReference Include="..\FireAntivirus.PrivacyProtection\FireAntivirus.PrivacyProtection.csproj" />
    <ProjectReference Include="..\FireAntivirus.RansomwareProtection\FireAntivirus.RansomwareProtection.csproj" />
    <ProjectReference Include="..\FireAntivirus.RealTimeProtectionPlus\FireAntivirus.RealTimeProtectionPlus.csproj" />
    <ProjectReference Include="..\FireAntivirus.Sandbox\FireAntivirus.Sandbox.csproj" />

    <ProjectReference Include="..\FireAntivirus.SecurityReport\FireAntivirus.SecurityReport.csproj" />
    <ProjectReference Include="..\FireAntivirus.SecurityScore\FireAntivirus.SecurityScore.csproj" />

    <ProjectReference Include="..\FireAntivirus.SystemOptimizer\FireAntivirus.SystemOptimizer.csproj" />
    <ProjectReference Include="..\FireAntivirus.ThreatIntelligence\FireAntivirus.ThreatIntelligence.csproj" />
    <ProjectReference Include="..\FireAntivirus.VulnerabilityScanner\FireAntivirus.VulnerabilityScanner.csproj" />
    <ProjectReference Include="..\FireAntivirus.WebProtection\FireAntivirus.WebProtection.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- NuGet包引用 -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="System.Management" Version="7.0.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- 图标与首页/关于页图片（随输出复制；UiKit 从 AppContext.BaseDirectory\Assets 读取） -->
    <Content Include="Assets\**\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- 保留内置图片资源 -->
    <Content Include="Resources\**\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- 威胁特征库（源目录 ThreatData：家族/哈希/YARA/勒索/挖矿等 JSON），缺失则家族识别与内置查杀全部空库 -->
    <Content Include="ThreatData\**\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- 沙箱组件（随软件分发）：Sandbox\Start.exe / SbieIni.exe（来自 Sandboxie-Plus），缺失时回退系统安装路径 -->
    <Content Include="Sandbox\**\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- 内核驱动打包（dist 由 FireAntivirus.Driver 构建产出） -->
    <Content Include="..\FireAntivirus.Driver\dist\FireAntivirusKrn.sys" CopyToOutputDirectory="PreserveNewest" Link="FireAntivirusKrn.sys" />
    <Content Include="..\FireAntivirus.Driver\dist\FireAntivirusKrn.inf" CopyToOutputDirectory="PreserveNewest" Link="FireAntivirusKrn.inf" Condition="Exists('..\FireAntivirus.Driver\dist\FireAntivirusKrn.inf')" />
  </ItemGroup>

</Project>
