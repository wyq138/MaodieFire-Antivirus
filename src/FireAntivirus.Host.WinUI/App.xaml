<!-- 耄耋软件工作室 开发，严禁非法反编译 -->
<Application
    x:Class="FireAntivirus.Host.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 全局现代深色主题资源 -->
            <SolidColorBrush x:Key="BrandBrush" Color="#FF3B82F6"/>
            <SolidColorBrush x:Key="BrandGradientStart" Color="#FF3B82F6"/>
            <SolidColorBrush x:Key="BrandGradientEnd" Color="#FF8B5CF6"/>
            <SolidColorBrush x:Key="CardBackground" Color="#1C1C1E"/>
            <SolidColorBrush x:Key="CardBorder" Color="#33FFFFFF"/>
            <SolidColorBrush x:Key="SafeBrush" Color="#FF22C55E"/>
            <SolidColorBrush x:Key="WarnBrush" Color="#FFF59E0B"/>
            <SolidColorBrush x:Key="DangerBrush" Color="#FFEF4444"/>
            <CornerRadius x:Key="CardCornerRadius">12</CornerRadius>
            <Thickness x:Key="CardPadding">20</Thickness>

            <Style x:Key="ModernCard" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource CardBackground}"/>
                <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}"/>
                <Setter Property="Padding" Value="{StaticResource CardPadding}"/>
            </Style>

            <Style x:Key="PageTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="28"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="0,4,0,16"/>
            </Style>

            <Style x:Key="MetricValue" TargetType="TextBlock">
                <Setter Property="FontSize" Value="30"/>
                <Setter Property="FontWeight" Value="Bold"/>
            </Style>

            <Style x:Key="MetricCaption" TargetType="TextBlock">
                <Setter Property="Opacity" Value="0.65"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Margin" Value="0,2,0,0"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
