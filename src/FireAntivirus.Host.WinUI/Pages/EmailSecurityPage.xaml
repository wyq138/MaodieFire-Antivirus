<Page
    x:Class="FireAntivirus.Host.WinUI.Pages.EmailSecurityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="24,16,24,24">
        <StackPanel Spacing="14" MaxWidth="920">

            <TextBlock Text="邮箱安全" Style="{StaticResource PageTitle}"/>

            <Border Style="{StaticResource ModernCard}">
                <StackPanel Spacing="10">
                    <TextBlock Text="邮件防护状态" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock x:Name="StatusText" Text="已启用 - 拦截钓鱼附件与恶意链接" Foreground="{StaticResource SafeBrush}" FontWeight="SemiBold"/>
                    <ToggleSwitch Header="扫描邮件附件" IsOn="True"/>
                    <ToggleSwitch Header="拦截钓鱼链接" IsOn="True"/>
                    <ToggleSwitch Header="拦截垃圾邮件特征" IsOn="True"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>