<!-- 耄耋软件工作室 开发，严禁非法反编译 -->
<Page
    x:Class="FireAntivirus.Host.WinUI.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="24,16,24,24">
        <StackPanel Spacing="14" MaxWidth="920">

            <TextBlock Text="设置" Style="{StaticResource PageTitle}"/>

            <Border Style="{StaticResource ModernCard}">
                <StackPanel Spacing="10">
                    <TextBlock Text="常规" FontSize="16" FontWeight="SemiBold"/>
                    <ToggleSwitch Header="开机自启动" IsOn="True"/>
                    <ToggleSwitch Header="最小化到托盘" IsOn="True"/>
                    <ToggleSwitch Header="自动更新特征库（每小时）" IsOn="True"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource ModernCard}">
                <StackPanel Spacing="10">
                    <TextBlock Text="检测与处理" FontSize="16" FontWeight="SemiBold"/>
                    <ToggleSwitch Header="实时防护" IsOn="True"/>
                    <ToggleSwitch Header="高风险仅隔离不删除" IsOn="True"/>
                    <ToggleSwitch Header="启用多阶段评分响应" IsOn="True"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource ModernCard}">
                <StackPanel Spacing="10">
                    <TextBlock Text="签名验证" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock x:Name="SignInfo" Opacity="0.75" Text="数字签名使用 .NET X509Certificate 库验证（非系统校验软件）。"/>
                    <Button Content="验证受感染文件签名" Click="VerifySign_Click" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource ModernCard}">
                <StackPanel Spacing="10">
                    <TextBlock Text="备份与数据" FontSize="16" FontWeight="SemiBold"/>
                    <Button Content="导出设置备份" Click="Export_Click" HorizontalAlignment="Left"/>
                    <Button Content="导入设置备份" Click="Import_Click" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>