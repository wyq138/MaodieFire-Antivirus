<!-- 耄耋软件工作室 开发，严禁非法反编译 -->
<Page
    x:Class="FireAntivirus.Host.WinUI.Pages.NetworkTrafficAnalyzerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="24,16,24,24">
        <StackPanel Spacing="14" MaxWidth="920">

            <TextBlock Text="网络流量分析" Style="{StaticResource PageTitle}"/>

            <!-- 实时速率 -->
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource ModernCard}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="上传速度" FontSize="13" Opacity="0.6" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="UploadSpeedText" Text="0 KB/s" FontSize="26" FontWeight="Bold" Foreground="{StaticResource BrandBrush}" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="UploadTotalText" Text="总计: 0 B" FontSize="12" Opacity="0.6" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource ModernCard}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="下载速度" FontSize="13" Opacity="0.6" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="DownloadSpeedText" Text="0 KB/s" FontSize="26" FontWeight="Bold" Foreground="{StaticResource SafeBrush}" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="DownloadTotalText" Text="总计: 0 B" FontSize="12" Opacity="0.6" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 应用流量 -->
            <Border Style="{StaticResource ModernCard}">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="刷新" Click="Refresh_Click"/>
                        <Button x:Name="StartBtn" Content="开始监控" Click="StartMonitor_Click"/>
                        <Button x:Name="StopBtn" Content="停止监控" IsEnabled="False" Click="StopMonitor_Click"/>
                    </StackPanel>
                    <TextBlock Text="应用流量排行（按连接数）" FontSize="14" FontWeight="SemiBold"/>
                    <ListView x:Name="AppTrafficList" MaxHeight="280">
                        <ListView.HeaderTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="8" Padding="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4*"/><ColumnDefinition Width="3*"/><ColumnDefinition Width="3*"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="应用" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="下载" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="2" Text="上传" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="3" Text="连接数" FontWeight="SemiBold"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.HeaderTemplate>
                    </ListView>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>