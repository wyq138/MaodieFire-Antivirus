<Page NavigationCacheMode="Required"
    x:Class="FireAntivirus.Host.WinUI.Pages.ProtectPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="28,10,28,24">
        <StackPanel Spacing="14" MaxWidth="920">

            <TextBlock Text="实时防护" Style="{StaticResource PageTitle}"/>

            <Border Style="{StaticResource ModernCard}">
                <StackPanel Spacing="14">
                    <TextBlock Text="防护模块" FontSize="16" FontWeight="SemiBold"/>

                    <ToggleSwitch x:Name="FileGuardToggle" Header="实时文件防护（监控临时/下载/启动目录，高危自动隔离）" Toggled="FileGuard_Toggled"/>
                    <ToggleSwitch x:Name="RansomToggle" Header="勒索防护（监控文档目录敏感文件写入）" Toggled="Ransom_Toggled"/>

                    <TextBlock x:Name="WatchCount" Opacity="0.6"/>
                    <TextBlock Opacity="0.6" Text="发现威胁时右下角弹窗提示；高危/严重威胁自动移入隔离区（可恢复），不直接删除文件。"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
