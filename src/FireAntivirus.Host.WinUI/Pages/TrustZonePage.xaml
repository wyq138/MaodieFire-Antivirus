<Page
    x:Class="FireAntivirus.Host.WinUI.Pages.TrustZonePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="24,16,24,24">
        <StackPanel Spacing="14" MaxWidth="920">

            <TextBlock Text="信任区" Style="{StaticResource PageTitle}"/>

            <Border Style="{StaticResource ModernCard}">
                <StackPanel Spacing="10">
                    <TextBlock Text="信任文件与文件夹（扫描时默认跳过）" Opacity="0.75"/>
                    <ListView x:Name="TrustListGrid" MaxHeight="320">
                        <ListView.HeaderTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="8" Padding="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="4*"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="类型" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="路径" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="2" Text="添加时间" FontWeight="SemiBold"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.HeaderTemplate>
                    </ListView>
                    <TextBlock x:Name="CountText" Opacity="0.6"/>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="添加文件" Click="AddTrustFile_Click"/>
                        <Button Content="添加文件夹" Click="AddTrustFolder_Click"/>
                        <Button Content="移除选中" Click="DeleteTrustItem_Click"/>
                        <Button Content="刷新" Click="Refresh_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>