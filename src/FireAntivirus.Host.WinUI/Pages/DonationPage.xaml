<!-- 耄耋软件工作室 开发，严禁非法反编译 -->
<Page
    x:Class="FireAntivirus.Host.WinUI.Pages.DonationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="24,16,24,24">
        <StackPanel Spacing="14" MaxWidth="920">

            <TextBlock Text="捐赠支持" Style="{StaticResource PageTitle}"/>

            <Border Style="{StaticResource ModernCard}">
                <StackPanel Spacing="12">
                    <TextBlock Text="支持耄耋安全软件" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Opacity="0.75" TextWrapping="Wrap"
                               Text="如果天盾引擎帮您拦截了威胁、保护了数据安全，欢迎通过捐赠支持我们持续开发。您的支持将用于：特征库更新、引擎检测能力提升与全新功能研发。"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource ModernCard}">
                <StackPanel Spacing="12">
                    <TextBlock Text="赞赏方式" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock x:Name="DonationInfo" Opacity="0.8" TextWrapping="Wrap"
                               Text="可通过应用内「关于」页获取官方联系与捐赠二维码。\n（当前构建未内嵌收款码图片，请以软件更新中提供的官方渠道为准，谨防仿冒。）"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>