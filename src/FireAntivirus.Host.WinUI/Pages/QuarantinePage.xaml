<Page NavigationCacheMode="Required"
    x:Class="FireAntivirus.Host.WinUI.Pages.QuarantinePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FireAntivirus.Host.WinUI.Pages">

    <Grid Padding="28,10,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="隔离区" Style="{StaticResource PageTitle}"/>
        <Border Grid.Row="1" Style="{StaticResource ModernCard}">
            <Grid RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button x:Name="RefreshBtn" Content="刷新" Click="Refresh_Click"/>
                    <TextBlock x:Name="CountText" Opacity="0.6" VerticalAlignment="Center"/>
                </StackPanel>
                <ListView x:Name="QuarantineList" Grid.Row="1">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:QuarantineRow">
                            <Grid ColumnSpacing="12" Padding="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{x:Bind FileName}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{x:Bind OriginalPath}" Opacity="0.6" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{x:Bind ThreatName}" Foreground="{StaticResource WarnBrush}" FontSize="12"/>
                                    <TextBlock Text="{x:Bind Severity, Mode=OneWay}" Opacity="0.6" FontSize="12"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{x:Bind When}" Opacity="0.6" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                                    <Button Content="恢复" Click="Restore_Click" Tag="{x:Bind Id}"/>
                                    <Button Content="删除" Click="Delete_Click" Tag="{x:Bind Id}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Page>