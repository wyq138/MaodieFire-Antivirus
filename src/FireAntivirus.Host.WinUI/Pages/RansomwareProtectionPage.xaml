<Page
    x:Class="FireAntivirus.Host.WinUI.Pages.RansomwareProtectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="24,16,24,24">
        <StackPanel Spacing="14" MaxWidth="920">

            <TextBlock Text="勒索防护" Style="{StaticResource PageTitle}"/>

            <Border Style="{StaticResource ModernCard}">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock x:Name="StatusText" Text="已启用" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource SafeBrush}"/>
                        <ToggleSwitch x:Name="ProtectionToggle" IsOn="True" Toggled="ProtectionToggle_Toggled"/>
                    </StackPanel>
                    <TextBlock Opacity="0.75" Text="保护受控文件夹防止被加密，检测到批量加密/删影子副本等高危动作时仅执行可逆隔离并告警。"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource ModernCard}">
                <StackPanel Spacing="10">
                    <TextBlock Text="受保护的文件夹" FontSize="16" FontWeight="SemiBold"/>
                    <ListView x:Name="ProtectedFoldersList" MaxHeight="220"/>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="添加文件夹" Click="AddFolder_Click"/>
                        <Button Content="移除选中" Click="RemoveFolder_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>