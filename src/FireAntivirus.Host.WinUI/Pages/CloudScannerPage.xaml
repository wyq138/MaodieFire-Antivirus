<Page
    x:Class="FireAntivirus.Host.WinUI.Pages.CloudScannerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="24,16,24,24">
        <StackPanel Spacing="14" MaxWidth="920">

            <TextBlock Text="云查杀" Style="{StaticResource PageTitle}"/>

            <Border Style="{StaticResource ModernCard}">
                <StackPanel Spacing="10">
                    <TextBlock Text="云引擎状态" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock x:Name="EnginesText" Text="检测中..." Opacity="0.75" TextWrapping="Wrap"/>
                    <TextBlock x:Name="VtStatusText" Text="VirusTotal: 未配置" Opacity="0.75"/>
                    <Button Content="配置 API Key" Click="ConfigBtn_Click" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource ModernCard}">
                <StackPanel Spacing="10">
                    <TextBlock Text="扫描方式" FontSize="16" FontWeight="SemiBold"/>
                    <RadioButton x:Name="QuickScanRadio" Content="快速扫描（系统目录）" IsChecked="True" GroupName="scanMode"/>
                    <RadioButton x:Name="FullScanRadio" Content="全盘查询" GroupName="scanMode"/>
                    <RadioButton x:Name="CustomScanRadio" Content="自定义路径" GroupName="scanMode"/>
                    <TextBlock x:Name="SelectedPathText" Opacity="0.6" Text="请选择文件或目录以进行云查杀"/>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="选择路径" Click="SelectFile_Click"/>
                        <Button x:Name="StartScanBtn" Content="开始扫描" Click="StartScan_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border x:Name="ProgressPanel" Style="{StaticResource ModernCard}" Visibility="Collapsed">
                <StackPanel Spacing="10">
                    <ProgressBar x:Name="ScanProgress" Maximum="100"/>
                    <TextBlock x:Name="ProgressText" Opacity="0.75"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>