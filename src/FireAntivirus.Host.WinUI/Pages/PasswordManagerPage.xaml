<Page
    x:Class="FireAntivirus.Host.WinUI.Pages.PasswordManagerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="24,16,24,24">
        <StackPanel Spacing="14" MaxWidth="920">

            <TextBlock Text="密码管理" Style="{StaticResource PageTitle}"/>

            <Border Style="{StaticResource ModernCard}">
                <StackPanel Spacing="8">
                    <TextBlock Text="主密码（本地加密存储）" FontSize="16" FontWeight="SemiBold"/>
                    <PasswordBox x:Name="MasterPwd" Width="300" PlaceholderText="设置/验证主密码"/>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="验证/解锁" Click="Unlock_Click"/>
                        <Button Content="修改主密码" Click="SetMaster_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="StatusText" Opacity="0.75" Text="保险库已锁定"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource ModernCard}">
                <StackPanel Spacing="10">
                    <TextBlock Text="保险库条目" FontSize="16" FontWeight="SemiBold"/>
                    <ListView x:Name="EntryList" MaxHeight="240"/>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SiteInput" PlaceholderText="站点/名称"/>
                        <TextBox x:Name="UserInput" Grid.Column="1" PlaceholderText="用户名"/>
                        <PasswordBox x:Name="PassInput" Grid.Column="2" PlaceholderText="密码"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="新增条目" Click="AddEntry_Click"/>
                        <Button Content="删除选中" Click="DeleteEntry_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>