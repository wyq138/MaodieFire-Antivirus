<Page
    x:Class="FireAntivirus.Host.WinUI.Pages.BehaviorAnalysisPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="24,16,24,24">
        <StackPanel Spacing="14" MaxWidth="920">

            <TextBlock Text="行为分析" Style="{StaticResource PageTitle}"/>

            <Border Style="{StaticResource ModernCard}">
                <StackPanel Spacing="10">
                    <TextBlock Text="行为监控状态" FontSize="16" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <ToggleSwitch x:Name="MonitorToggle" Header="实时行为监控" IsOn="True" Toggled="MonitorToggle_Toggled"/>
                    </StackPanel>
                    <TextBlock x:Name="StatusText" Opacity="0.75" Text="监控进程注入、加密、删影子副本等高危行为，阶段分>60 或破坏动作发生时响应。"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource ModernCard}">
                <StackPanel Spacing="10">
                    <TextBlock Text="行为事件" FontSize="16" FontWeight="SemiBold"/>
                    <ListView x:Name="EventList" MaxHeight="320"/>
                    <Button Content="刷新事件" Click="Refresh_Click" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>