<!-- 耄耋软件工作室 开发，严禁非法反编译 -->
<Page
    x:Class="FireAntivirus.Host.WinUI.Pages.PerformanceDiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="24,16,24,24">
        <StackPanel Spacing="14" MaxWidth="920">

            <TextBlock Text="性能诊断" Style="{StaticResource PageTitle}"/>

            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource ModernCard}">
                    <StackPanel>
                        <TextBlock x:Name="CpuText" Text="--%" FontSize="30" FontWeight="Bold" Foreground="{StaticResource BrandBrush}"/>
                        <TextBlock Text="CPU 占用" Style="{StaticResource MetricCaption}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource ModernCard}">
                    <StackPanel>
                        <TextBlock x:Name="MemText" Text="--%" FontSize="30" FontWeight="Bold" Foreground="{StaticResource SafeBrush}"/>
                        <TextBlock Text="内存占用" Style="{StaticResource MetricCaption}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource ModernCard}">
                    <StackPanel>
                        <TextBlock x:Name="UpText" Text="--" FontSize="30" FontWeight="Bold" Foreground="{StaticResource WarnBrush}"/>
                        <TextBlock Text="运行时长" Style="{StaticResource MetricCaption}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource ModernCard}">
                <StackPanel Spacing="10">
                    <TextBlock Text="诊断项目" FontSize="16" FontWeight="SemiBold"/>
                    <ListView x:Name="DiagList" MaxHeight="340">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Result}"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Button Content="重新诊断" Click="Diagnose_Click" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>