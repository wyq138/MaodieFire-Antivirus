<Page
    x:Class="FireAntivirus.Host.WinUI.Pages.SecurityScorePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="24,16,24,24">
        <StackPanel Spacing="14" MaxWidth="920">

            <TextBlock Text="安全评分" Style="{StaticResource PageTitle}"/>

            <Border Style="{StaticResource ModernCard}">
                <StackPanel Spacing="16" HorizontalAlignment="Center">
                    <TextBlock x:Name="ScoreText" Text="--" FontSize="64" FontWeight="Bold" Foreground="{StaticResource SafeBrush}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="ScoreLabel" Text="系统安全" FontSize="16" HorizontalAlignment="Center" Opacity="0.7"/>
                    <ProgressBar x:Name="ScoreBar" Maximum="100" Width="360" Height="8"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource ModernCard}">
                <StackPanel Spacing="10">
                    <TextBlock Text="评分项" FontSize="16" FontWeight="SemiBold"/>
                    <ListView x:Name="ScoreList" MaxHeight="320"/>
                    <Button Content="重新评分" Click="ReScore_Click" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>