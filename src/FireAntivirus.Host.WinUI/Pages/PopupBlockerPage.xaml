<!-- 耄耋软件工作室 开发，严禁非法反编译 -->
<Page
    x:Class="FireAntivirus.Host.WinUI.Pages.PopupBlockerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="24,16,24,24">
        <StackPanel Spacing="14" MaxWidth="920">

            <TextBlock Text="弹窗拦截" Style="{StaticResource PageTitle}"/>

            <Border Style="{StaticResource ModernCard}">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock x:Name="StatusText" Text="弹窗拦截已启用" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource SafeBrush}"/>
                        <ToggleSwitch x:Name="GlobalToggle" IsOn="True" Toggled="GlobalToggle_Toggled"/>
                    </StackPanel>
                    <TextBlock Opacity="0.75" Text="拦截恶意弹窗、广告弹窗与诱导安装窗口，防止误点造成风险。"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource ModernCard}">
                <StackPanel Spacing="10">
                    <TextBlock Text="拦截日志" FontSize="16" FontWeight="SemiBold"/>
                    <ListView x:Name="LogList" MaxHeight="260"/>
                    <Button Content="清空日志" Click="ClearLog_Click" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>