<Page
    x:Class="FireAntivirus.Host.WinUI.Pages.StartupManagerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="24,16,24,24">
        <StackPanel Spacing="14" MaxWidth="920">

            <TextBlock Text="启动管理" Style="{StaticResource PageTitle}"/>

            <Border Style="{StaticResource ModernCard}">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="刷新启动项" Click="Refresh_Click"/>
                        <Button Content="禁用选中项" Click="Disable_Click"/>
                        <Button Content="启用选中项" Click="Enable_Click"/>
                    </StackPanel>
                    <ListView x:Name="StartupList" MaxHeight="420">
                        <ListView.HeaderTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="8" Padding="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4*"/><ColumnDefinition Width="5*"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="名称" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="命令" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="2" Text="状态" FontWeight="SemiBold"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.HeaderTemplate>
                    </ListView>
                    <TextBlock x:Name="CountText" Opacity="0.6"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>