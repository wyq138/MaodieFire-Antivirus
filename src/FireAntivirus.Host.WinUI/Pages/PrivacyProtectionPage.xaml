<Page
    x:Class="FireAntivirus.Host.WinUI.Pages.PrivacyProtectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="24,16,24,24">
        <StackPanel Spacing="14" MaxWidth="920">

            <TextBlock Text="隐私保护" Style="{StaticResource PageTitle}"/>

            <Border Style="{StaticResource ModernCard}">
                <StackPanel Spacing="8">
                    <TextBlock Text="隐私清理" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock x:Name="StatusText" Opacity="0.75" Text="尚未执行清理"/>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="清理浏览器缓存" Click="Clean_Browsers_Click"/>
                        <Button Content="清理剪贴板历史" Click="Clean_Clipboard_Click"/>
                        <Button Content="清理临时追踪文件" Click="Clean_Temp_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource ModernCard}">
                <StackPanel Spacing="10">
                    <TextBlock Text="隐私设置" FontSize="16" FontWeight="SemiBold"/>
                    <ToggleSwitch Header="禁止应用读取剪贴板" IsOn="False"/>
                    <ToggleSwitch Header="屏蔽遥测数据上报" IsOn="True"/>
                    <ToggleSwitch Header="清除位置追踪记录" IsOn="True"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>