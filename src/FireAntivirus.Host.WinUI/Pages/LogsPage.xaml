<Page
    x:Class="FireAntivirus.Host.WinUI.Pages.LogsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="24,16,24,24">
        <StackPanel Spacing="14" MaxWidth="960">

            <TextBlock Text="日志" Style="{StaticResource PageTitle}"/>

            <Border Style="{StaticResource ModernCard}">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="刷新日志" Click="Refresh_Click"/>
                        <Button Content="清空日志" Click="Clear_Click"/>
                        <TextBlock x:Name="CountText" VerticalAlignment="Center" Opacity="0.6"/>
                    </StackPanel>
                    <ListView x:Name="LogList" MaxHeight="420">
                        <ListView.HeaderTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="10" Padding="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="时间" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="类型" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="2" Text="内容" FontWeight="SemiBold"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.HeaderTemplate>
                    </ListView>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>