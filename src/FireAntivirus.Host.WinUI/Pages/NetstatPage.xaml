<Page NavigationCacheMode="Required"
    x:Class="FireAntivirus.Host.WinUI.Pages.NetstatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="28,10,28,24" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="网络连接" Style="{StaticResource PageTitle}"/>

        <!-- 流量监控（原独立"网络流量"页能力整合）：可疑连接告警与实时流量分析 -->
        <Border Grid.Row="1" Style="{StaticResource ModernCard}">
            <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button x:Name="TrafficStartBtn" Content="开启流量监控" Click="TrafficStart_Click"/>
                    <Button x:Name="TrafficStopBtn" Content="停止监控" Click="TrafficStop_Click"/>
                    <Button Content="分析流量" Click="TrafficAnalyze_Click"/>
                    <TextBlock x:Name="TrafficState" Opacity="0.65" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="TrafficAlertText" Opacity="0.75" TextWrapping="Wrap" FontSize="12"
                           Text="可疑连接告警将显示在这里"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource ModernCard}">
            <Grid RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button x:Name="RefreshBtn" Content="刷新" Style="{StaticResource AccentButtonStyle}" Click="Refresh_Click"/>
                    <TextBox x:Name="FilterBox" Width="260" PlaceholderText="按进程/地址筛选..." TextChanged="Filter_TextChanged"/>
                    <TextBlock x:Name="CountText" Opacity="0.6" VerticalAlignment="Center"/>
                </StackPanel>
                <ListView x:Name="ConnList" Grid.Row="1" SelectionMode="Single"/>
            </Grid>
        </Border>
    </Grid>
</Page>
