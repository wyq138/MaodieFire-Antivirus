<Page NavigationCacheMode="Required"
    x:Class="FireAntivirus.Host.WinUI.Pages.SysInfoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="28,10,28,24">
        <StackPanel Spacing="14" MaxWidth="920">
            <TextBlock Text="系统信息" Style="{StaticResource PageTitle}"/>
            <Border Style="{StaticResource ModernCard}">
                <StackPanel x:Name="InfoPanel" Spacing="10"/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
