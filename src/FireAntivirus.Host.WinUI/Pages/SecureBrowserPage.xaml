<!-- 耄耋软件工作室 开发，严禁非法反编译 -->
<Page
    x:Class="FireAntivirus.Host.WinUI.Pages.SecureBrowserPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="24,16,24,24">
        <StackPanel Spacing="14" MaxWidth="920">

            <TextBlock Text="安全浏览器" Style="{StaticResource PageTitle}"/>

            <Border Style="{StaticResource ModernCard}">
                <StackPanel Spacing="10">
                    <TextBlock Text="安全模式浏览器" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Opacity="0.75" Text="在沙箱隔离的安全环境打开网页，拦截恶意脚本与钓鱼站点，浏览记录不落盘。"/>
                    <TextBlock x:Name="StatusText" Opacity="0.6" Text="就绪"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox x:Name="UrlInput" Width="320" PlaceholderText="输入网址，如 https://example.com"/>
                        <Button Content="打开安全浏览" Click="OpenSecure_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource ModernCard}">
                <StackPanel Spacing="10">
                    <TextBlock Text="安全特性" FontSize="16" FontWeight="SemiBold"/>
                    <ToggleSwitch Header="拦截恶意脚本" IsOn="True"/>
                    <ToggleSwitch Header="拦截弹窗" IsOn="True"/>
                    <ToggleSwitch Header="禁用 Cookie" IsOn="False"/>
                    <ToggleSwitch Header="无痕浏览" IsOn="True"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>