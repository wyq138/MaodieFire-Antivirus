<!-- 耄耋软件工作室 开发，严禁非法反编译 -->
<Page
    x:Class="FireAntivirus.Host.WinUI.Pages.ToolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24,16,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="工具箱" Style="{StaticResource PageTitle}"/>

        <Grid Grid.Row="1" ColumnSpacing="16" RowSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/><ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/><RowDefinition/>
            </Grid.RowDefinitions>

            <Border Style="{StaticResource ModernCard}">
                <StackPanel Spacing="10">
                    <FontIcon Glyph="&#xE7B8;" FontSize="26"/>
                    <TextBlock Text="特征库自检" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock x:Name="SelfCheckText" Opacity="0.7" TextWrapping="Wrap"/>
                    <Button Content="重新自检" Click="SelfCheck_Click"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource ModernCard}" Grid.Column="1">
                <StackPanel Spacing="10">
                    <FontIcon Glyph="&#xE963;" FontSize="26"/>
                    <TextBlock Text="病毒库更新" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Opacity="0.7" TextWrapping="Wrap">从 abuse.ch 拉取最新恶意哈希 / URL / IP，自动或手动更新到特征库。</TextBlock>
                    <Button x:Name="UpdateBtn" Content="立即更新" Click="Update_Click"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource ModernCard}" Grid.Row="1">
                <StackPanel Spacing="10">
                    <FontIcon Glyph="&#xE8F1;" FontSize="26"/>
                    <TextBlock Text="系统优化" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock x:Name="OptText" Opacity="0.7">清理临时文件与无效启动项。</TextBlock>
                    <Button Content="开始优化" Click="Optimize_Click"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource ModernCard}" Grid.Row="1" Grid.Column="1">
                <StackPanel Spacing="10">
                    <FontIcon Glyph="&#xE72D;" FontSize="26"/>
                    <TextBlock Text="关于防护引擎" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock x:Name="EngineText" Opacity="0.7" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>