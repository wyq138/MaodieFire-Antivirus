<!-- 耄耋软件工作室 开发，严禁非法反编译 -->
<Page
    x:Class="FireAntivirus.Host.WinUI.Pages.WebProtectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="24,16,24,24">
        <StackPanel Spacing="14" MaxWidth="920">

            <TextBlock Text="网页防护" Style="{StaticResource PageTitle}"/>

            <Border Style="{StaticResource ModernCard}">
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock x:Name="StatusText" Text="网页防护已启用" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource SafeBrush}"/>
                    </StackPanel>
                    <TextBlock Opacity="0.6" Text="先匹配自动更新的恶意 URL/IP 特征库拦截，离线时回退硬编码网段，拦截提示「恶意 URL/C2 连接已被拦截」。"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource ModernCard}">
                <StackPanel Spacing="10">
                    <TextBlock Text="拦截策略" FontSize="16" FontWeight="SemiBold"/>
                    <ToggleSwitch Header="拦截钓鱼网站" IsOn="True" Toggled="Settings_Toggled"/>
                    <ToggleSwitch Header="拦截恶意软件下载站" IsOn="True" Toggled="Settings_Toggled"/>
                    <ToggleSwitch Header="拦截广告" IsOn="True" Toggled="Settings_Toggled"/>
                    <ToggleSwitch Header="拦截跟踪器" IsOn="True" Toggled="Settings_Toggled"/>
                    <ToggleSwitch Header="拦截弹窗广告" IsOn="True" Toggled="Settings_Toggled"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource ModernCard}">
                <StackPanel Spacing="10">
                    <TextBlock Text="自定义黑名单" FontSize="16" FontWeight="SemiBold"/>
                    <ListView x:Name="BlacklistBox" MaxHeight="130"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox x:Name="BlacklistInput" Width="260" PlaceholderText="输入网址或域名"/>
                        <Button Content="添加" Click="AddBlacklist_Click"/>
                        <Button Content="移除选中" Click="RemoveBlacklist_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource ModernCard}">
                <StackPanel Spacing="10">
                    <TextBlock Text="自定义白名单" FontSize="16" FontWeight="SemiBold"/>
                    <ListView x:Name="WhitelistBox" MaxHeight="130"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox x:Name="WhitelistInput" Width="260" PlaceholderText="输入网址或域名"/>
                        <Button Content="添加" Click="AddWhitelist_Click"/>
                        <Button Content="移除选中" Click="RemoveWhitelist_Click"/>
                    </StackPanel>
                    <Button Content="保存设置" Click="Save_Click" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>