<Page x:Class="FireAntivirus.Host.WinUI.Pages.NetworkPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="24,16,24,24">
        <StackPanel Spacing="14" MaxWidth="920">
            <TextBlock Text="网络连接" Style="{StaticResource PageTitle}"/>
            <Border Style="{StaticResource ModernCard}">
                <StackPanel Spacing="12">
                    <TextBlock x:Name="NetStateText" Text="网络状态检测中..." FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock x:Name="NetDetailText" Opacity="0.6" TextWrapping="Wrap"/>
                    <Button Content="重新检测" Click="Refresh_Click" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>