<Page
    x:Class="FireAntivirus.Host.WinUI.Pages.SystemOptimizerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="24,16,24,24">
        <StackPanel Spacing="14" MaxWidth="920">

            <TextBlock Text="系统优化" Style="{StaticResource PageTitle}"/>

            <Border Style="{StaticResource ModernCard}">
                <StackPanel Spacing="10">
                    <TextBlock Text="系统资源状态" FontSize="16" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Name="CpuUsage" Text="CPU: --%" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource BrandBrush}"/>
                        <TextBlock x:Name="MemoryUsage" Text="内存: --%" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource SafeBrush}"/>
                    </StackPanel>
                    <ProgressBar x:Name="CpuProgress" Maximum="100"/>
                    <ProgressBar x:Name="MemoryProgress" Maximum="100"/>
                    <TextBlock x:Name="EstimatedSpace" Opacity="0.6" Text="预计可释放: 计算中..."/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource ModernCard}">
                <StackPanel Spacing="10">
                    <TextBlock Text="优化选项" FontSize="16" FontWeight="SemiBold"/>
                    <ToggleSwitch Header="清理临时文件" IsOn="True"/>
                    <ToggleSwitch Header="清理回收站" IsOn="True"/>
                    <ToggleSwitch Header="清理浏览器缓存" IsOn="True"/>
                    <ToggleSwitch Header="清理无效注册表项" IsOn="False"/>
                    <Button Content="一键优化" Click="Optimize_Click" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>