<Page
    x:Class="FireAntivirus.Host.WinUI.Pages.MobileSecurityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="24,16,24,24">
        <StackPanel Spacing="14" MaxWidth="920">

            <TextBlock Text="移动安全" Style="{StaticResource PageTitle}"/>

            <Border Style="{StaticResource ModernCard}">
                <StackPanel Spacing="10">
                    <TextBlock Text="连接的移动设备" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock x:Name="DeviceStatus" Opacity="0.75" Text="正在检测已连接的移动设备..."/>
                    <Button Content="重新检测" Click="Detect_Click"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource ModernCard}">
                <StackPanel Spacing="10">
                    <TextBlock Text="移动安全建议" FontSize="16" FontWeight="SemiBold"/>
                    <ToggleSwitch Header="启用 USB 设备自动扫描" IsOn="True"/>
                    <ToggleSwitch Header="传输开启时阻止恶意自动运行" IsOn="True"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>