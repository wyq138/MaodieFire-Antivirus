<Page NavigationCacheMode="Required"
    x:Class="FireAntivirus.Host.WinUI.Pages.StartupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="28,10,28,24" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="启动项管理" Style="{StaticResource PageTitle}"/>

        <Border Grid.Row="1" Style="{StaticResource ModernCard}">
            <Grid RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button x:Name="RefreshBtn" Content="刷新" Click="Refresh_Click"/>
                    <TextBlock x:Name="CountText" Opacity="0.6" VerticalAlignment="Center"/>
                </StackPanel>
                <ListView x:Name="StartupList" Grid.Row="1" SelectionMode="Single"/>
            </Grid>
        </Border>
    </Grid>
</Page>
