<Page
    x:Class="FireAntivirus.Host.WinUI.Pages.NetworkFirewallPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="24,16,24,24">
        <StackPanel Spacing="14" MaxWidth="920">
            <TextBlock Text="网络防火墙" Style="{StaticResource PageTitle}"/>
            <Border Style="{StaticResource ModernCard}">
                <StackPanel Spacing="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock x:Name="FirewallStatusText" Text="防火墙已启用" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource SafeBrush}"/>
                            <TextBlock Text="拦截恶意网络连接、端口扫描与C2通信" Opacity="0.6"/>
                        </StackPanel>
                        <ToggleSwitch x:Name="FirewallToggle" Grid.Column="1" IsOn="True" OnContent="开" OffContent="关" Toggled="FirewallToggle_Toggled"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="刷新连接" Click="RefreshConnections_Click"/>
                        <Button Content="添加规则" Click="AddRule_Click"/>
                        <Button Content="移除规则" Click="RemoveRule_Click"/>
                    </StackPanel>
                    <ListView x:Name="ActiveConnectionsGrid" MaxHeight="260" SelectionMode="Single">
                        <ListView.HeaderTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="8" Padding="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3*"/><ColumnDefinition Width="3*"/><ColumnDefinition Width="3*"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="进程" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="本地地址" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="2" Text="远程地址" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="3" Text="端口" FontWeight="SemiBold"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.HeaderTemplate>
                    </ListView>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>