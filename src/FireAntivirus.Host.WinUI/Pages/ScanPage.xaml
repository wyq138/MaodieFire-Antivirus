<Page NavigationCacheMode="Required"
    x:Class="FireAntivirus.Host.WinUI.Pages.ScanPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FireAntivirus.Host.WinUI.Pages">

    <Grid Padding="28,10,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="病毒扫描" Style="{StaticResource PageTitle}"/>

        <!-- 扫描目标选择（顶部横向排列） -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" Margin="0,0,0,14">
            <Button x:Name="QuickBtn" Content="快速扫描" Style="{StaticResource AccentButtonStyle}" Click="Quick_Click"/>
            <Button x:Name="FullBtn" Content="完整扫描" Click="Full_Click"/>
            <Button x:Name="CustomBtn" Content="自定义目录" Click="Custom_Click"/>
            <Button x:Name="StopBtn" Content="停止扫描" Click="Stop_Click" IsEnabled="False"/>
            <TextBox x:Name="PathBox" Width="360" PlaceholderText="选择扫描路径..."/>
        </StackPanel>

        <!-- 进度 + 结果 -->
        <Grid Grid.Row="2" RowSpacing="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Style="{StaticResource ModernCard}">
                <StackPanel Spacing="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ScanState" Text="就绪" FontWeight="SemiBold"/>
                        <TextBlock x:Name="ScanStats" Grid.Column="1" Opacity="0.65"/>
                    </Grid>
                    <ProgressBar x:Name="Progress" Minimum="0" Maximum="100" Value="0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource ModernCard}" Grid.Row="1">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="检测结果" FontSize="16" FontWeight="SemiBold"/>
                    <ListView x:Name="ThreatList" Grid.Row="1" SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:ThreatRow">
                                <Grid ColumnSpacing="12" Padding="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{x:Bind ThreatName}" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}"/>
                                        <TextBlock Text="{x:Bind FilePath}" Opacity="0.6" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{x:Bind Severity}" VerticalAlignment="Center" Opacity="0.7"/>
                                    <Button Grid.Column="2" Content="处理" Click="Handle_Click" Tag="{x:Bind FilePath}"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
