<Window
    x:Class="FireAntivirus.Host.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FireAntivirus.Host.WinUI">

    <Grid>
        <NavigationView
            x:Name="Nav"
            IsBackButtonVisible="Auto"
            IsTitleBarAutoPaddingEnabled="False"
            OpenPaneLength="224"
            SelectionChanged="Nav_SelectionChanged"
            IsSettingsVisible="False">

            <NavigationView.Resources>
                <ResourceDictionary>
                    <!-- 顶栏 Header 已移除, 清零模板为 Header 区保留的默认间距（否则内容区顶部空白过高） -->
                    <Thickness x:Key="NavigationViewHeaderMargin">0,0,0,0</Thickness>
                    <Thickness x:Key="NavigationViewMinimalHeaderMargin">0,0,0,0</Thickness>
                    <Thickness x:Key="NavigationViewHeaderSeparatorMargin">0,0,0,0</Thickness>
                </ResourceDictionary>
            </NavigationView.Resources>

            <NavigationView.MenuItems>
                <NavigationViewItem Content="首页" Tag="home">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="病毒扫描" Tag="scan">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE721;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="实时防护" Tag="protect">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE72E;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="隔离与信任" Tag="quarantine-center">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE74D;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemSeparator/>
                <NavigationViewItem Content="安全中心" Tag="security-center">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8A5;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="漏洞扫描" Tag="vul">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7BA;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="网络连接" Tag="netstat">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE774;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="网络防火墙" Tag="firewall">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D9;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemSeparator/>
                <NavigationViewItem Content="网页与邮件安全" Tag="web-security">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE715;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="设备与隐私" Tag="device-privacy">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7F4;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="密码库" Tag="password">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8D7;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="数据备份" Tag="backup">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B7;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemSeparator/>
                <NavigationViewItem Content="系统监控" Tag="system-monitor">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE950;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="系统工具" Tag="system-tools">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9F5;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="日志" Tag="logs">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="设置" Tag="settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="关于" Tag="about">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>


            <!-- 内容区 + 右下角威胁浮层 -->
            <Grid>
                <!-- 页面托管容器（替代 Frame）：纯代码 Page 未经 XamlTypeInfo 注册，
                     Frame.Navigate(Type) 会挂起（六页卡死根因），改由代码直接 Add 页面实例 -->
                <Grid x:Name="PageHost"/>

            </Grid>
        </NavigationView>
    </Grid>
</Window>